---
// Índice privado de TODOS los artículos, publicados y sin publicar, marcados
// con su estado. Protegido por el middleware de Vercel.
//
// Además de listarlos, es la mesa de revisión: por cada artículo se puede
// marcar «listo para publicar» o «hay que cambiar algo» y dejar una nota. El
// mecanismo vive en <RevisionBar /> y se comparte con el kit de redes.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RevisionBar from '../../components/RevisionBar.astro';
import RevisionItem from '../../components/RevisionItem.astro';
import revisiones from '../../data/revisiones.json';

const guardadas: Record<string, { estado?: string; nota?: string; titulo?: string; fecha?: string; fecha_prevista?: string }> =
  (revisiones as any).posts || {};

const all = (await getCollection('blog'))
  .map((e) => {
    const [lang, ...rest] = e.id.split('/');
    const slug = rest.join('/');
    const isPub = e.data.status === 'publish';
    const key = `${lang}/${slug}`;
    const rev = guardadas[key] || {};
    return {
      key,
      lang,
      slug,
      isPub,
      title: e.data.title,
      excerpt: e.data.excerpt || '',
      image: e.data.featured_image || '',
      date: e.data.date ? e.data.date.toISOString().slice(0, 10) : '',
      tags: e.data.tags || [],
      estado: rev.estado || '',
      nota: rev.nota || '',
      fechaPrevista: rev.fecha_prevista || '',
      // Los publicados enlazan a la web real; los borradores, a su vista previa.
      href: isPub ? `/${lang}/blog/${slug}/` : `/borradores/${lang}/${slug}/`,
    };
  })
  // Primero los borradores (que son los que hay que revisar), luego por fecha.
  .sort((a, b) => (a.isPub === b.isPub ? (a.date < b.date ? 1 : -1) : a.isPub ? 1 : -1));

const drafts = all.filter((p) => !p.isPub).length;
const published = all.length - drafts;
const listos = all.filter((p) => p.estado === 'listo').length;
const conNotas = all.filter((p) => p.estado === 'cambios').length;
const sinRevisar = all.length - listos - conNotas;
---

<BaseLayout
  title="Todos los artículos"
  description="Vista privada de artículos publicados y sin publicar."
  lang="es"
  permalink="/borradores/"
  bodyClass="page is-blog is-draft-preview"
>
  <div class="draft-bar">
    <span class="draft-bar-tag">Privado</span>
    <span class="draft-bar-text">
      Solo tú ves esta página. Están <strong>todos</strong> los artículos, marcados según su estado.
    </span>
    <a class="draft-bar-link" href="/admin/">Ir al panel</a>
    <a class="draft-bar-link" href="/kit-redes/">Kit de redes</a>
    <a class="draft-bar-link" href="/calendario/">Calendario</a>
  </div>

  <section class="blog-hero">
    <div class="blog-hero-inner">
      <span class="blog-hero-eyebrow mono">Festival ADAR · Privado</span>
      <h1 class="blog-hero-title">Artículos<span class="blog-dot">.</span></h1>
      <p class="blog-hero-lede">
        {drafts} sin publicar · {published} publicado{published === 1 ? '' : 's'}.
        Los borradores se abren en vista previa con el diseño real; los publicados, en la web.
      </p>
      <p class="blog-hero-lede rev-intro">
        Debajo de cada uno puedes marcar si está <strong>listo para publicar</strong> o si
        <strong>hay que cambiar algo</strong>, y dejar una nota diciendo qué. Se guarda al momento
        en este navegador; con <em>Guardar en GitHub</em> se suben todas juntas y ya las leo yo para
        ir afinando los siguientes.
      </p>

      <div class="draft-filters mono" data-group="estado">
        <span class="filter-label">Publicación</span>
        <button type="button" data-filter="all" class="on">Todos ({all.length})</button>
        <button type="button" data-filter="draft">Sin publicar ({drafts})</button>
        <button type="button" data-filter="pub">Publicados ({published})</button>
      </div>

      <div class="draft-filters mono" data-group="revision">
        <span class="filter-label">Revisión</span>
        <button type="button" data-rev="all" class="on">Todas</button>
        <button type="button" data-rev="sin">Sin revisar (<span data-rv-count="sin">{sinRevisar}</span>)</button>
        <button type="button" data-rev="listo">Listos (<span data-rv-count="listo">{listos}</span>)</button>
        <button type="button" data-rev="cambios">Con notas (<span data-rv-count="cambios">{conNotas}</span>)</button>
      </div>
    </div>
  </section>

  <section class="blog-list-wrap">
    {all.length === 0 ? (
      <p class="blog-empty">Todavía no hay artículos.</p>
    ) : (
      <ul class="blog-list" id="draft-list">
        {all.map((p) => (
          <li
            class="blog-card"
            data-state={p.isPub ? 'pub' : 'draft'}
            data-rv-item
            data-rv-key={p.key}
            data-rv-title={p.title}
          >
            <a class="blog-card-link" href={p.href}>
              {p.image && (
                <span class="blog-card-img"><img src={p.image} alt="" loading="lazy" /></span>
              )}
              <span class="blog-card-body">
                <span class="blog-card-meta mono">
                  <span class={`state-pill ${p.isPub ? 'is-pub' : 'is-draft'}`}>
                    {p.isPub ? 'Publicado' : 'Sin publicar'}
                  </span>
                  <span class="rv-pill" data-rv-pill hidden></span>
                  {[p.date, p.lang.toUpperCase()].filter(Boolean).join(' · ')}
                </span>
                <span class="blog-card-title">{p.title}</span>
                {p.excerpt && <span class="blog-card-excerpt">{p.excerpt}</span>}
                <span class="blog-card-cta mono">{p.isPub ? 'Ver en la web' : 'Ver borrador'} →</span>
              </span>
            </a>

            {/* Fuera del enlace: si estuviera dentro, pulsar un botón navegaría. */}
            <RevisionItem nota={p.nota} fecha={p.fechaPrevista} class="mono" />
          </li>
        ))}
      </ul>
    )}
  </section>

  <RevisionBar
    path="src/data/revisiones.json"
    lsKey="adar_revisiones_v1"
    guardadas={guardadas}
    unidad="artículo"
  />

  <style>
    .filter-label {
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.55;
      margin-right: 4px;
      align-self: center;
    }
    .draft-filters + .draft-filters { margin-top: 8px; }
    .rev-intro { margin-top: 10px; opacity: 0.8; font-size: 0.95em; }
  </style>

  <script is:inline>
    (function () {
      var list = document.getElementById('draft-list');
      if (!list) return;

      // Dos filtros independientes que se combinan: estado de publicación y
      // estado de revisión (este último lo escribe <RevisionBar /> en
      // data-rv-state).
      var fEstado = 'all';
      var fRev = 'all';

      function aplicar() {
        list.querySelectorAll('.blog-card').forEach(function (card) {
          var okEstado = fEstado === 'all' || card.dataset.state === fEstado;
          var okRev = fRev === 'all' || card.dataset.rvState === fRev;
          card.style.display = okEstado && okRev ? '' : 'none';
        });
      }

      function grupo(selector, prop, set) {
        document.querySelectorAll(selector).forEach(function (b) {
          b.addEventListener('click', function () {
            set(b.dataset[prop]);
            document.querySelectorAll(selector).forEach(function (x) {
              x.classList.toggle('on', x === b);
            });
            aplicar();
          });
        });
      }
      grupo('[data-group="estado"] button', 'filter', function (v) { fEstado = v; });
      grupo('[data-group="revision"] button', 'rev', function (v) { fRev = v; });

      // Al marcar o desmarcar hay que rehacer el filtro de revisión.
      document.addEventListener('rv:change', aplicar);
      aplicar();
    })();
  </script>
</BaseLayout>
