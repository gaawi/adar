---
// Kit de redes · Festival ADAR. El material son los artículos del blog.
// Toda la herramienta vive en components/KitRedes.astro.
import { getCollection } from 'astro:content';
import KitRedes from '../components/KitRedes.astro';
import { BRANDS, buildPost, sortPosts } from '../data/kit-brands';

const brand = BRANDS.adar;

const posts = sortPosts(
  (await getCollection('blog')).map((e) => {
    const [lang, ...rest] = e.id.split('/');
    return buildPost(
      {
        lang,
        slug: rest.join('/'),
        title: e.data.title,
        excerpt: e.data.excerpt || '',
        image: e.data.featured_image || '',
        status: e.data.status,
        date: e.data.date ? e.data.date.toISOString().slice(0, 10) : '',
        tags: e.data.tags || [],
        body: e.body || '',
      },
      brand
    );
  })
);
---

<KitRedes brand={brand} posts={posts} />
