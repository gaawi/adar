    buscamosP: 'Nun hai restricción de xéneru nin de disciplina. Un cuartetu de cuerda, un grupu de jazz, una artista visual o un proyeutu de danza tienen les mesmes posibilidaes. Tampoco fai falta que la propuesta seya esperimental, interdisciplinar o de temática rural.',
    valores: [
      ['Singularidá', 'Una identidá artística propia.'],
      ['Curiosidá', 'Nueves perspeutives sobre la creación y la interpretación.'],
      ['Diálogu', 'Apertura hacia otres cultures, disciplines y sensibilidaes.'],
      ['Proximidá', 'Capacidá de xenerar esperiencies significatives col públicu.'],
      ['Territoriu', 'Voluntá d’averar esperiencies artístiques de calidá al mediu rural.'],
    ],
    cuandoH: 'Calendariu',
    cuandoP: 'La convocatoria ábrese n’avientu de 2026. El plazu de presentación acaba’l 1 de marzu de 2027 y los proyeutos escoyíos preséntense na edición de branu del festival.',
    cuandoP2: 'El restu de feches —resultaos y composición del comité artísticu— publíquense coles bases.',
    volver: 'Toles formes de participar',
  },
}[lang];

const PROPUESTAS: Record<Lang, string> = {
  es: '/es/propuestas-artisticas/',
  en: '/en/submit-a-proposal/',
  ast: '/ast/propuestes-artistiques/',
};

const translations = Object.fromEntries(LANGS.map((l) => [l, `/${l}/adar-next/`]));
---

<BaseLayout
  title={COPY.title}
  description={COPY.lede}
  lang={lang}
  permalink={`/${lang}/adar-next/`}
  featuredImage={IMG}
  translations={translations}
  bodyClass="page has-header-image"
>
  <Hero eyebrow={COPY.eyebrow} title={COPY.title} lede={COPY.lede} image={IMG} />

  <div class="builder-wrap full-width">
  <article class="page type-page status-publish hentry">
  <div class="entry-content">
  <div class="adar-impact-v3 adar-res-call nx-doc">

    <section class="ed-section nx-top">
      <div class="ed-wrap">
        <div class="nx-aviso">
          <p class="ed-stat-t">{COPY.avisoT}</p>
          <p>{COPY.avisoP}</p>
          <p>{COPY.avisoP2} <a href={PROPUESTAS[lang]}>{COPY.avisoLink}</a>.</p>
        </div>
      </div>
    </section>

    <section class="ed-section" id="que-es">
      <div class="ed-wrap">
        <div class="ed-head"><h2>{COPY.queH}</h2></div>
        <p class="ed-prose">{COPY.queP1}</p>
        <p class="ed-prose">{COPY.queP2}</p>
      </div>
    </section>

    <section class="ed-section" id="calendario">
      <div class="ed-wrap">
        <div class="ed-head"><h2>{COPY.cuandoH}</h2></div>
        <p class="ed-prose">{COPY.cuandoP}</p>
        <p class="ed-prose">{COPY.cuandoP2}</p>
      </div>
    </section>

    <section class="ed-section" id="que-ofrecemos">
      <div class="ed-wrap">
        <div class="ed-head"><h2>{COPY.ofrecemosH}</h2></div>
        <ul class="rc-when-list rc-managers">
          {COPY.ofrecemos.map((o) => <li>{o}</li>)}
        </ul>
      </div>
    </section>

    <section class="ed-section" id="que-buscamos">
      <div class="ed-wrap">
        <div class="ed-head">
          <h2>{COPY.buscamosH}</h2>
          <p class="ed-lede">{COPY.buscamosP}</p>
        </div>
        <ul class="rc-when-list rc-managers">
          {COPY.valores.map(([k, v]) => <li><strong>{k}.</strong> {v}</li>)}
        </ul>
      </div>
    </section>

    <section class="ed-section" id="por-que">
      <div class="ed-wrap">
        <div class="ed-head"><h2>{COPY.porqueH}</h2></div>
        <p class="ed-prose">{COPY.porqueP1}</p>
        <p class="ed-prose">{COPY.porqueP2}</p>
        <p class="ed-prose">{COPY.porqueP3}</p>
      </div>
    </section>

    <section class="ed-section">
      <div class="ed-wrap">
        <p class="ed-prose nx-volver">
          <a href={`/${lang}/participa/`}>← {COPY.volver}</a>
        </p>
      </div>
    </section>

  </div>
  </div>
  </article>
  </div>
</BaseLayout>

<style is:global>
  body.page .entry-content > div > .nx-doc > section { padding: 0; }
  body.page .entry-content .nx-doc .nx-top { padding-top: 0; }
  body.page .entry-content .nx-doc .nx-aviso {
    border-left: 3px solid #9a5b12;
    background: rgba(154, 91, 18, 0.06);
    padding: 18px 22px;
    max-width: 46rem;
  }
  body.page .entry-content .nx-doc .nx-aviso .ed-stat-t { color: #9a5b12; }
  body.page .entry-content .nx-doc .nx-aviso p { margin: 8px 0 0; font-size: 15px; line-height: 1.55; }
  body.page .entry-content .nx-doc .nx-aviso p:first-child { margin: 0; }
  body.page .entry-content .nx-doc .nx-volver { font-family: var(--font-mono); font-size: 13px; }
</style>
