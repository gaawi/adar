    volver: 'All the ways to take part',
  },
  ast: {
    title: 'ADAR NEXT',
    eyebrow: 'Convocatoria internacional',
    lede: 'Beyond networks · Beyond genres · Beyond cities. La convocatoria ábrese n’avientu de 2026.',
    avisoT: 'Entá nun ta abierta',
    avisoP: 'La convocatoria d’ADAR NEXT ábrese n’avientu de 2026, coles bases completes y el formulariu d’inscripción. Esta páxina esplica’l proyeutu pa que puedas dir preparando la propuesta.',
    avisoP2: 'Mentanto sigue abierta la vía de siempres, de baldre y ensin plazu:',
    avisoLink: 'propuestes artístiques',
    queH: 'Qué ye',
