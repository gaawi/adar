---
// ADAR NEXT. La convocatoria todavía no está abierta —se abre en diciembre de
// 2026— así que esta página explica el proyecto y no publica las bases.
//
// Lo que NO sale aquí: el importe de la cuota de inscripción —él pidió el 27
// de noviembre de 2026 no publicarla todavía en ningún sitio—, cuántos
// proyectos se seleccionan, la fecha de resultados, el comité artístico y los
// límites de los gastos de viaje y producción.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import type { Lang } from '../../i18n/strings.ts';
import { LANGS } from '../../i18n/strings.ts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const IMG = 'https://creartbox-media-cdn.b-cdn.net/adarimages/IMG_8026.JPG';

const COPY = {
