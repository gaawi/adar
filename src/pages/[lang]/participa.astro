---
// Página central de participación: todas las formas de entrar en ADAR, con su
// estado y su plazo, más el archivo de las que ya cerraron.
//
// No lleva contenido propio sobre las convocatorias: todo sale de
// src/data/convocatorias.ts, que es el único sitio donde se abren y se cierran.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ConvocatoriaCard from '../../components/ConvocatoriaCard.astro';
import type { Lang } from '../../i18n/strings.ts';
import { LANGS } from '../../i18n/strings.ts';
import { porEstado, archivo } from '../../data/convocatorias.ts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const EMAIL = 'leiguardamusic@gmail.com';

const COPY = {
  es: {
    title: 'Participa',
    eyebrow: 'Formas de entrar en ADAR',
    lede: 'Todas las convocatorias del festival en una sola página, con su estado y su plazo. Si buscas la forma de trabajar con nosotros, empieza aquí.',
    intro1: 'ADAR no tiene una única puerta. Se puede entrar proponiendo un concierto, pidiendo una residencia, cediendo un hórreo para que suene música dentro, o trayendo a tu festival a músicos de aquí. Cada vía tiene sus condiciones y su calendario, y están todas abajo.',
    intro2: 'Lo que no esté en esta página, no está abierto. Y lo que cierre, se queda en el archivo del final para que se pueda consultar.',
    abiertas: 'Abiertas ahora',
    abiertasSub: 'Se puede solicitar hoy.',
    proximas: 'Próximamente',
