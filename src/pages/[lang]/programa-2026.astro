const EV_I18N: Record<string, Record<string, any>> = {
  en: {
  "01": { "venueNote": "Two 30-minute sittings", "title": "Of Dances and Sonatas", "subtitle": "Micro-concert in a hórreo · Harpsichord recital · Opening · Hórreos & Paneras Competition", "description": "A journey through some of the dance forms that shaped keyboard music between the 16th and 18th centuries. From the Renaissance variations of Antonio de Cabezón and the celebrated Folías de España—one of the most influential harmonic progressions in history—to the refined English suite of Henry Purcell and the unmistakable idiom of Domenico Scarlatti, dance appears here transformed into a space for invention, virtuosity and expression. The programme culminates in the monumental Chaconne from J. S. Bach's Partita for solo violin in D minor, in Brahms's transcription—a work that raises an old Baroque dance to one of the summits of Western musical literature.", "programName": "Of Dances and Sonatas" },
  "02": { "title": "The Shape of Memory", "subtitle": "ADAR ON TOUR · Piano trio concert", "description": "The trio of María Martínez, Frederieke Saeijs and Josefina Urraca explores the ideas of remembrance and mourning from the library of the Parador de Corias, a former 11th-century Benedictine monastery. A chamber programme that brings together the Classicism of Haydn, Lili Boulanger's Nocturne, Messiaen's Louange à l'immortalité de Jésus (from the Quartet for the End of Time), Rachmaninoff's Trio élégiaque, Shostakovich's First Piano Trio and a recent work by Brittney Benton, in one of the most secluded settings in western Asturias." },
  "03": { "title": "The Shape of Memory", "subtitle": "Piano trio concert", "description": "A second reading of the programme The Shape of Memory, this time in Llanes. The same trio performs the same works, but the acoustics of the new space rewrite the piece. A way to see how place transforms music: the same repertoire does not sound the same in the light of dusk in a seaside town in the east as it does in the library of a parador in the west." },
  "04": { "title": "UMBRAL ZERO", "subtitle": "Concert of minimalist music and visual art", "programNote": "Visuals for the programme by Guillermo Laporta; the video art for the Bach Suite is by Guillermo Ordás.", "venueNote": "First sitting (20:30) sold out · second sitting at 21:30, booking open", "description": "A programme for flute and piano built on minimalism: music that tends toward zero, reducing gesture to a minimum until it brushes against silence—hence the title, \"Umbral Zero\" (Threshold Zero). Guillermo Laporta and Josefina Urraca link the minimalism of Max Richter with the bare simplicity of Satie and Bach, alongside a recent piece by Zygmund de Somogyi for amplified flute and electronics. The Aula del Oro in Belmonte de Miranda, a former exhibition space of the municipality, hosts an intimate chamber evening with visual projection woven into the programme.", "programName": "Umbral Zero" },
  "05": { "title": "Site-specific intervention · Menhir collective", "subtitle": "Open art installation · Two days · Site-specific creation", "description": "«Claros de Cueva» is not a conventional concert: it is a sound walk you listen to on your phone with headphones as you walk through Leiguarda. You download a free app (Echoes) and, depending on where you go, the phone's GPS triggers music, sounds and words tied to each spot; all you have to do is walk and listen. The route starts at the church and ends at the Palomar (dovecote), where an installation awaits you. You can do it at your own pace, alone or in a group, at any time on 8 and 9 August. The Menhir collective, who created the piece, will not be present: the work lives in the landscape and in the app. All you need is a charged phone, headphones and a wish to walk.", "programNote": "Claros de Cueva · geolocated sound walk and installation, from the church of Leiguarda to the Palomar; a dialogue with María Zambrano's «Claros del bosque»." },
  "06": { "title": "The Rest is Silence", "subtitle": "ADAR ON TOUR · Concert of chamber music and visual art", "description": "A mosaic-programme built on the idea of solitude. Fifteen short pieces from the 20th and 21st centuries alternate with canons from Bach's Musical Offering that act as bridges between the works. Ligeti, Gubaidulina, Kurtág, Webern, Penderecki, Stravinsky, Gerhard and Cage build a sequence deliberately broken by the regularity of Bach. The Rest Project trio arrives at the As Quintas Auditorium in El Franco with a visual staging and a programme heard in a single sweep, with no applause between pieces.", "programName": "The Rest is Silence" },
  "07": { "title": "Micro concert at the Centro ADAR during the eclipse", "subtitle": "Piano quintet", "description": "A micro concert at the Centro ADAR in Leiguarda, coinciding with the solar eclipse. The quintet formed by Maria Florea, Lara Fernández, Daniel Claret, Guillermo Laporta and Josefina Urraca performs the first movement of Antonín Dvořák's Piano Quintet No. 2 in A major, Op. 81, and Devin Cholodenko's Twilight at Dawn." },
  "08": { "title": "Concert of chamber music and visual art", "subtitle": "ADAR ON TOUR", "description": "Beneath the vaults of the Cistercian monastery of Villanueva de Oscos, founded in the 12th century, the ensemble brings together Devin Cholodenko's Twilight at Dawn, the second movement of Schubert's String Trio, Joan Magrané's Andante sostenuto —co-commissioned by L'Auditori de Barcelona—, Brahms's Piano Quartet in C minor Op. 60, and two movements of Dvořák's Quintet Op. 81. Classical and contemporary repertoire read within a 12th-century nave." },
  "09": { "venueNote": "Two 20-minute sittings", "title": "Equilibrium", "subtitle": "Residency showcase · The Rest Project", "description": "\"Equilibrium\" takes 3 as the number of balance—spirit, soul and body: three musicians and three composers in harmony. Coinciding with the centenary of György Kurtág, the trio The Rest Project shares the work developed during its artistic residency at the hórreo, an open programme still in the making. Throughout the concert, the poetry of Joan Margarit also resounds—a poet with whom the group shares a personal bond.", "programName": "Equilibrium" },
  "10": { "title": "Sound walk in Leiguarda", "subtitle": "Site-specific creation", "description": "A sound walk through the valley with stops at different stations along the route. The quintet Hoffman / Brazauskas / Saeijs / Laporta / Urraca performs original works, arrangements and improvisation along the way, weaving the landscape into the score. Capacity is limited for mobility reasons: the group walks alongside the audience from station to station. Comfortable footwear recommended.", "programNote": "Site-specific creation with original works, arrangements and improvisation throughout the valley of Leiguarda." },
  "11": { "title": "Closing · Quintet concert and espicha", "subtitle": "Close of the 6th edition", "description": "The close of the 6th edition. The same quintet that gave the sound walk the previous day reunites in the parish church of Leiguarda for a concentrated programme that runs from Vivaldi in Bach's transcription and Mendelssohn to the first movement of Brahms's Clarinet Trio, and continues with Ravel's Ma mère l'Oye, Ligeti's Musica Ricercata, David Lang's sweet air and a traditional mazurka (Monterosano Mazurka) to close. After the concert, an open espicha (traditional Asturian cider gathering) for everyone in the church grounds. The long night that sends off the festival." }
},
  ast: {
  "01": { "venueNote": "Dos pases de 30 minutos", "title": "De danzas y sonates", "subtitle": "Micro conciertu n'hórreu · Recital de clave · Inauguración · Concursu d'Hórreos y Paneres", "description": "Un recorríu por delles de les formes de danza que vertebraron la música pa teclau ente los sieglos XVI y XVIII. Dende les variaciones renacentistes d'Antonio de Cabezón y les célebres Folíes d'España —una de les progresiones armóniques más influyentes de la hestoria— hasta la refinada suite inglesa de Henry Purcell y el inconfundible llinguaxe de Domenico Scarlatti, la danza apaez tresformada nun espaciu d'invención, virtuosismu y espresión. El recorríu remata cola monumental Chacona de la Partita pa violín en re menor de J. S. Bach, na trescripción fecha por Brahms, una obra qu'alza una antigua danza barroca a una de les cumes de la lliteratura musical occidental.", "programName": "De danzas y sonates" },
  "02": { "title": "La forma de la memoria", "subtitle": "ADAR EN RUTA · Conciertu de tríu con pianu", "description": "El tríu de María Martínez, Frederieke Saeijs y Josefina Urraca traviesa la idea del recuerdu y el duelu dende la biblioteca del Parador de Corias, antiguu monasteriu benedictín del sieglu XI. Un programa de cámara qu'axunta'l clasicismu de Haydn, el Nocturne de Lili Boulanger, la Louange à l'immortalité de Jésus de Messiaen (del Cuartetu pal fin de los tiempos), el Trío élégiaque de Rajmáninov, el Tríu con pianu n.º 1 de Shostakóvich y una obra reciente de Brittney Benton, nun de los entornos más recoyíos del occidente asturianu." },
  "03": { "title": "La forma de la memoria", "subtitle": "Conciertu de tríu con pianu", "description": "Segunda llectura del programa La forma de la memoria, agora en Llanes. El mesmu tríu interpreta les mesmes obres, pero l'acústica del nuevu espaciu reescribe la pieza. Una manera de comprobar cómo'l llugar tresforma la música: el mesmu repertoriu nun suena igual a la lluz del atapecer nuna villa marinera del oriente qu'na biblioteca d'un parador del occidente." },
  "04": { "title": "UMBRAL ZERO", "subtitle": "Conciertu de música minimalista y arte visual", "programNote": "Arte visual del programa a cargu de Guillermo Laporta; el videoarte de la Suite de Bach ye de Guillermo Ordás.", "venueNote": "Primer pase (20:30) escosáu · segundu pase a les 21:30, con reserves abiertes", "description": "Programa de flauta y pianu construyíu sobre'l minimalismu: una música que tiende a cero, que reduz el xestu al mínimu hasta rozar el silenciu —d'ehí'l títulu, «Umbral Zero»—. Guillermo Laporta y Josefina Urraca enllacen el minimalismu de Max Richter cola desnudez de Satie y de Bach, xunto a una pieza reciente de Zygmund de Somogyi pa flauta amplificada y electrónica. L'Aula del Oru de Belmonte de Miranda, antiguu espaciu espositivu del conceyu, acueye una nueche íntima de cámara con proyección visual integrada nel programa.", "programName": "Umbral Zero" },
  "05": { "title": "Intervención site-specific · Coleutivu Menhir", "subtitle": "Instalación artística abierta · Dos xornaes · Creación site-specific", "description": "«Claros de Cueva» nun ye un conciertu al usu: ye un paséu sonoru qu'escuches col móvil y unos auriculares mientres caminas por Lleiguarda. Descargues una app de baldre (Echoes) y, según per ónde vaigas, el GPS del teléfonu va disparando músiques, sonidos y pallabres amestaos a cada llugar; tu namás tienes qu'andar y escuchar. El recorríu entama na ilesia y remata nel Palombar, onde t'espera una instalación. Puedes facelo al to ritmu, en solitariu o en grupu, en cualquier momentu del 8 y el 9 d'agostu. El Coleutivu Menhir, autor de la obra, nun va tar presente: la pieza vive nel paisaxe y na app. Namás necesites el móvil cargáu, auriculares y ganes de caminar.", "programNote": "Claros de Cueva · recorríu sonoru xeollocalizáu ya instalación, dende la ilesia de Lleiguarda hasta'l Palombar; un diálogu con «Claros del bosque» de María Zambrano." },
  "06": { "title": "The Rest is Silence", "subtitle": "ADAR EN RUTA · Conciertu de música de cámara y arte visual", "description": "Programa-mosaicu construyíu sobre la idea de la soledá. Quince pieces breves del sieglu XX y XXI alternaes con cánones de la Ofrenda Musical de Bach que furrulen como fugues ente los temes. Ligeti, Gubaidúlina, Kurtág, Webern, Penderecki, Stravinsky, Gerhard y Cage construyen una secuencia rota deliberadamente pola regularidá de Bach. El tríu The Rest Project aterriza nel Auditoriu As Quintas d'El Franco con escenografía visual y un programa que s'escucha d'un tirón, ensin aplausos ente pieces.", "programName": "The Rest is Silence" },
  "07": { "title": "Micro conciertu nel Centru ADAR durante l'eclís", "subtitle": "Quintetu con pianu", "description": "Micro conciertu nel Centru ADAR de Lleiguarda, coincidiendo col eclís solar. El quintetu formáu por Maria Florea, Lara Fernández, Daniel Claret, Guillermo Laporta y Josefina Urraca interpreta'l primer movimientu del Quintetu pa pianu n.º 2 en la mayor, op. 81, d'Antonín Dvořák, y «Twilight at Dawn» de Devin Cholodenko." },
  "08": { "title": "Conciertu de música de cámara y arte visual", "subtitle": "ADAR EN RUTA", "description": "So les bóvedes del monasteriu cisterciense de Villanueva de Uscos, fundáu nel sieglu XII, el conxuntu axunta «Twilight at Dawn» de Devin Cholodenko, el segundu movimientu del Tríu de cuerdes de Schubert, l'Andante sostenuto de Joan Magrané —coencargu de L'Auditori de Barcelona—, el Cuartetu con pianu op. 60 de Brahms y dos movimientos del Quintetu op. 81 de Dvořák. Repertoriu clásicu y contemporáneu lleíu nuna nave del sieglu XII." },
  "09": { "venueNote": "Dos pases de 20 minutos", "title": "Equilibrium", "subtitle": "Muestra de residencia · The Rest Project", "description": "«Equilibrium» parte del 3 como númberu del equilibriu —espíritu, alma y cuerpu—: trés músicos y trés compositores n'armonía. Coincidiendo col centenariu de György Kurtág, el tríu The Rest Project amuesa'l trabayu desarrolláu na so residencia artística nel hórreu, un programa abiertu y en construcción. A lo llargo del conciertu resuena amás la poesía de Joan Margarit, con quien el grupu comparte un vencelu personal.", "programName": "Equilibrium" },
  "10": { "title": "Paséu sonoru en Lleiguarda", "subtitle": "Creación site-specific", "description": "Caminata sonora pel valle con paraes en distintes estaciones del recorríu. El quintetu Hoffman / Brazauskas / Saeijs / Laporta / Urraca interpreta obres orixinales, iguadures ya improvisación a lo llargo del trayeutu, integrando'l paisaxe na partitura. Aforu llimitáu por motivos de movilidá: el grupu camina xunto al públicu ente estación y estación. Encaláu cómodu recomendáu.", "programNote": "Creación site-specific con obres orixinales, iguadures ya improvisación a lo llargo del valle de Lleiguarda." },
  "11": { "title": "Zarru · Conciertu de quintetu y espicha", "subtitle": "Zarru de la VI edición", "description": "Zarru de la VI edición. El mesmu quintetu que firmó'l paséu sonoru del día anterior s'axunta de nuevu na ilesia parroquial de Lleiguarda pa un programa concentráu que percuerre a Vivaldi na transcripción de Bach, Mendelssohn y el primer movimientu del Tríu pa clarinete de Brahms, y sigue con Ma mère l'Oye de Ravel, Musica Ricercata de Ligeti, sweet air de David Lang y una mazurca tradicional (Monterosano Mazurka) pa despidir. Tres del conciertu, espicha abierta pa tol públicu nel campu de la ilesia. La nueche llarga que despide'l festival." }
},
};
