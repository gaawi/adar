// Creative team credited for the edition beyond the performing lineup
// (resident composer, cinematographer). Rendered in the Cartel section.
const EXTRA_CREDITS: Performer[] = [
  { name: 'Zygmund de Somogyi', role: 'Compositor residente' },
  { name: 'Guillermo Ordás', role: 'Cinematógrafo' },
];

// Build a unique artist list (preserving instrument labels from first occurrence)
const seen = new Set<string>();
const ARTISTS = [...EVENTS.flatMap((e) => e.artists), ...EXTRA_CREDITS].filter((a) => {
  if (seen.has(a.name)) return false;
  seen.add(a.name);
  return true;
});

// Map each performer name to its individual bio page (slug artista-*/artist-*)
// for the CURRENT language, so names in the programme link to the bio we
// actually have. Matching is by normalized title; if there is no published
// bio for a name it simply stays plain text (never a dead link).
const normName = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, ' ').trim();
const BIO_HREF = new Map<string, string>();
for (const p of await getCollection('pages')) {
  if (p.data.lang !== lang) continue;
  if (p.data.status !== 'publish') continue;
  const perma = p.data.permalink || `/${lang}/${p.data.slug}/`;
  if (!/\/(artista|artist)-/.test(perma)) continue;
  BIO_HREF.set(normName(p.data.title), perma);
}
const bioHref = (name: string): string | undefined => BIO_HREF.get(normName(name));

// ISO start datetime per concert so the client can mark past ones as
// "celebrado" (the programme advances on its own each day, no rebuild).
// August in Asturias is CEST (UTC+2). For multi-day events use the last day.
function eventStartISO(fullDate: string, time: string): string {
  const days = (fullDate.match(/\d+/g) || ['1']).map(Number);
  const day = String(days[days.length - 1]).padStart(2, '0');
  const tm = (time.match(/\d{1,2}:\d{2}/) || ['20:30'])[0];
  return `2026-08-${day}T${tm}:00+02:00`;
}
