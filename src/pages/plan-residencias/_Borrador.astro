---
// Envoltorio de los borradores privados: cabecera de aviso, el mismo
// contenedor que usan las páginas de contenido (los estilos del sitio están
// atados a .entry-content) y el enlace de vuelta al plan.
//
// El guion bajo del nombre evita que Astro lo convierta en una ruta.
interface Props {
  titulo: string;
  destino: string;
  idiomas?: string;
}
const { titulo, destino, idiomas = 'Se traducirá a inglés y asturiano al aprobarlo.' } = Astro.props;
---

<div class="builder-wrap full-width">
<article class="page type-page status-publish hentry">
<div class="entry-content">
<div class="adar-impact-v3 adar-res-call pr-doc">

  <section class="ed-section">
    <div class="ed-wrap">
      <p class="pr-volver"><a href="/plan-residencias/">← Plan de residencias y ADAR NEXT</a></p>
      <div class="pr-banner">
        <p class="ed-stat-t">Borrador privado · sin publicar</p>
        <p>Si lo apruebas, esta página se publica en <code>{destino}</code>. {idiomas}</p>
      </div>
      <h1 class="pr-h1">{titulo}</h1>
    </div>
  </section>

  <slot />

</div>
</div>
</article>
</div>

<style is:global>
  .pr-doc .pr-volver { margin: 0 0 18px; font-family: var(--font-mono); font-size: 12px; }
  .pr-doc .pr-volver a { color: var(--muted); text-decoration: none; border-bottom: 1px solid currentColor; }
  .pr-doc .pr-banner {
    border: 1px dashed var(--line, rgba(10,9,7,.3));
    padding: 14px 16px;
    margin: 0 0 26px;
    max-width: 46rem;
  }
  .pr-doc .pr-banner p:last-child { margin: 6px 0 0; font-size: 13px; }
  /* El tema heredado trae `.entry-content h1, h1:not(.entry-title)…`, que
     dejaba el titular en 24px y en blanco. Selector largo para ganarle. */
  body.page .entry-content .pr-doc .pr-h1 {
    color: var(--ink, #0a0907);
    font-family: var(--font-voz);
    font-weight: var(--peso-titulo);
    font-size: clamp(30px, 4.2vw, 52px);
    line-height: 1.05;
    margin: 10px 0 18px;
  }
  .pr-doc .pr-nota { max-width: 46rem; }
  .pr-doc .pr-tabla-wrap { overflow-x: auto; max-width: 46rem; }
  .pr-doc .pr-tabla { border-collapse: collapse; width: 100%; font-family: var(--font-mono); font-size: 14px; }
  .pr-doc .pr-tabla th,
  .pr-doc .pr-tabla td { text-align: left; padding: 10px 14px 10px 0; border-bottom: 1px solid var(--line, rgba(10,9,7,.14)); }
  .pr-doc .pr-tabla th { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .pr-doc .pr-pendiente {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em;
    text-transform: uppercase; color: #9a5b12; border: 1px solid currentColor;
    padding: 2px 7px; display: inline-block;
  }
</style>
