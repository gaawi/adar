---
// Mecanismo de revisión compartido: barra fija, avisos y toda la lógica.
//
// Funciona sobre cualquier lista. Cada ficha se marca con
//   data-rv-item data-rv-key data-rv-title
// y lleva dentro un <RevisionItem />. La barra:
//   · guarda las marcas al instante en el navegador (no espera a nada),
//   · las sube al repositorio con el login de GitHub del panel,
//   · deja `data-rv-state` en cada ficha («listo», «cambios» o «sin») para que
//     cada página lo combine con sus propios filtros,
//   · lanza el evento `rv:change` en document cuando algo cambia.
//
// Escribir en GitHub usa el token del usuario que devuelve /api/auth, el mismo
// que usa el CMS. No hace falta ningún secreto en el servidor.
interface Props {
  /** Ruta del JSON en el repositorio donde se acumulan las revisiones. */
  path: string;
  /** Clave de localStorage; dos páginas de la misma marca deben compartirla. */
  lsKey: string;
  /** Marcas ya guardadas en el repositorio (vienen del build). */
  guardadas: Record<string, { estado?: string; nota?: string; titulo?: string; fecha?: string; fecha_prevista?: string }>;
  repo?: string;
  branch?: string;
  /** Cómo se llama una ficha en los mensajes. */
  unidad?: string;
}
const {
  path,
  lsKey,
  guardadas,
  repo = 'gaawi/adar',
  branch = 'main',
  unidad = 'artículo',
} = Astro.props;

const config = { path, lsKey, repo, branch, unidad, guardadas };
---

<div class="rv-bar" id="rv-bar" hidden>
  <span class="rv-bar-text" id="rv-bar-text"></span>
  <button type="button" class="rv-bar-btn" id="rv-copy">Copiar notas</button>
  <button type="button" class="rv-bar-btn is-primary" id="rv-save">Guardar en GitHub</button>
</div>

<div class="rv-toast" id="rv-toast" role="status" aria-live="polite"></div>

<script type="application/json" id="rv-config" set:html={JSON.stringify(config).replace(/</g, '\\u003c')}></script>
<!-- Sin defer ni async: el script de abajo lo necesita ya cargado. -->
<script is:inline src="/kit/gh.js"></script>

<!-- Global: los estilos tienen que alcanzar el marcado de la página anfitriona,
     que tiene otro ámbito. Los colores salen de tokens con alternativa, así
     que valen igual sobre papel que sobre fondo oscuro. -->
<style is:global>
  /* Los colores van con alternativa dentro de var(), no como :root propio: si
     se definieran aquí competirían en igualdad con los de la página anfitriona
     y decidiría el orden del CSS, que es justo lo que no queremos. Así, quien
     defina --rv-* manda siempre. */

  /* Un display propio gana al atributo `hidden`, que solo trae display:none de
     la hoja del navegador. Sin esto, ocultar no oculta. */
  .rv-pill[hidden],
  .rv-note[hidden],
  .rv-bar[hidden] { display: none; }

  .rv-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--rv-radius, 999px);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .rv-pill.is-listo { color: var(--rv-ok, #2f6b3a); }
  .rv-pill.is-cambios { color: var(--rv-warn, #9a5b12); }

  .rv {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-start;
    padding-top: 12px;
    border-top: 1px dashed var(--line, rgba(128, 128, 128, 0.35));
    margin-top: 12px;
  }
  .rv-group-label {
    flex: 0 0 100%;
    font-family: var(--font-mono, inherit);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .rv-choice { display: flex; flex-wrap: wrap; gap: 6px; }
  .rv-choice button {
    font-family: var(--font-mono, inherit);
    font-size: 12px;
    line-height: 1;
    padding: 8px 12px;
    border-radius: var(--rv-radius, 999px);
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.6;
    white-space: nowrap;
    transition: opacity 0.15s, background 0.15s, color 0.15s;
  }
  .rv-choice button:hover { opacity: 1; }
  .rv-choice button.on { opacity: 1; font-weight: 600; }
  .rv-choice button[data-rv-set='listo'].on {
    background: var(--rv-ok, #2f6b3a);
    border-color: var(--rv-ok, #2f6b3a);
    color: var(--rv-ok-ink, #ffffff);
  }
  .rv-choice button[data-rv-set='cambios'].on {
    background: var(--rv-warn, #9a5b12);
    border-color: var(--rv-warn, #9a5b12);
    color: var(--rv-warn-ink, #ffffff);
  }
  .rv-clear { opacity: 0.35; }
  /* Quitar la marca solo tiene sentido si hay marca. */
  [data-rv-item]:not(.rv-has) .rv-clear { display: none; }

  .rv-fecha { display: flex; flex-direction: column; gap: 4px; }
  .rv-fecha input {
    font-family: var(--font-mono, inherit);
    font-size: 12px;
    padding: 7px 10px;
    border: 1px solid var(--line, rgba(128, 128, 128, 0.4));
    border-radius: var(--rv-radius, 999px);
    background: var(--card, rgba(255, 255, 255, 0.72));
    color: inherit;
    color-scheme: var(--rv-scheme, light);
  }
  /* Aprobado pero sin fecha: quien publique no sabría cuándo. */
  [data-rv-item].rv-sin-fecha .rv-fecha input { border-color: var(--rv-warn, #9a5b12); }

  .rv-note { flex: 1 1 320px; display: flex; flex-direction: column; gap: 4px; }
  .rv-note-label {
    font-family: var(--font-mono, inherit);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .rv-note textarea {
    font-family: inherit;
    font-size: 13px;
    line-height: 1.45;
    padding: 8px 10px;
    border: 1px solid var(--line, rgba(128, 128, 128, 0.4));
    border-radius: var(--rv-radius-sm, 6px);
    background: var(--card, rgba(255, 255, 255, 0.72));
    color: inherit;
    resize: vertical;
    width: 100%;
  }

  .rv-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 120;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding: 12px 20px;
    background: var(--rv-bar-bg, var(--fg, var(--ink, #0a0907)));
    color: var(--rv-bar-fg, var(--bg, var(--paper, #f6f4ee)));
    border-top: 1px solid var(--rv-bar-line, transparent);
    box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.22);
  }
  .rv-bar-text { flex: 1 1 220px; font-family: var(--font-mono, inherit); font-size: 12px; }
  .rv-bar-btn {
    font-family: var(--font-mono, inherit);
    font-size: 12px;
    line-height: 1;
    padding: 10px 16px;
    border-radius: var(--rv-radius, 999px);
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
  }
  .rv-bar-btn:hover {
    background: var(--rv-bar-fg, var(--bg, var(--paper, #f6f4ee)));
    color: var(--rv-bar-bg, var(--fg, var(--ink, #0a0907)));
  }
  .rv-bar-btn.is-primary {
    background: var(--accent, #f5d72f);
    border-color: var(--accent, #f5d72f);
    color: var(--on-accent, #0a0907);
    font-weight: 600;
  }
  .rv-bar-btn[disabled] { opacity: 0.45; cursor: progress; }
  body.rv-bar-on { padding-bottom: 86px; }

  .rv-toast {
    position: fixed;
    left: 50%;
    bottom: 84px;
    transform: translate(-50%, 16px);
    background: var(--rv-bar-bg, var(--fg, var(--ink, #0a0907)));
    color: var(--rv-bar-fg, var(--bg, var(--paper, #f6f4ee)));
    border: 1px solid var(--rv-bar-line, transparent);
    font-family: var(--font-mono, inherit);
    font-size: 13px;
    padding: 11px 18px;
    border-radius: var(--rv-radius, 999px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
    z-index: 130;
    max-width: 90vw;
    text-align: center;
  }
  .rv-toast.show { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 640px) {
    .rv { flex-direction: column; }
    .rv-note { flex: 1 1 auto; width: 100%; }
  }
</style>

<script is:inline>
  (function () {
    var CFG = JSON.parse(document.getElementById('rv-config').textContent);
    var GUARDADAS = CFG.guardadas || {};
    var fichas = document.querySelectorAll('[data-rv-item]');
    if (!fichas.length) return;

    // ── Estado ────────────────────────────────────────────────────────────
    // Base: lo que ya está en el repositorio (viene del build). Encima, lo de
    // este navegador, que puede ser más reciente.
    var estado = {};
    Object.keys(GUARDADAS).forEach(function (k) { estado[k] = Object.assign({}, GUARDADAS[k]); });
    var local = {};
    try { local = JSON.parse(localStorage.getItem(CFG.lsKey) || '{}'); } catch (e) { local = {}; }
    Object.keys(local).forEach(function (k) {
      var a = estado[k], b = local[k];
      if (!a || !a.fecha || (b.fecha && b.fecha > a.fecha)) estado[k] = b;
    });

    // Marcas hechas aquí y todavía no subidas.
    var sucio = {};
    Object.keys(local).forEach(function (k) {
      var g = GUARDADAS[k];
      var l = local[k];
      if (!g || g.estado !== l.estado || (g.nota || '') !== (l.nota || '') ||
          (g.fecha_prevista || '') !== (l.fecha_prevista || '') ||
          JSON.stringify(g.textos || {}) !== JSON.stringify(l.textos || {})) sucio[k] = true;
    });

    function persistir() {
      var salida = {};
      Object.keys(estado).forEach(function (k) {
        if (ADAR_GH.tieneAlgo(estado[k])) salida[k] = estado[k];
      });
      try { localStorage.setItem(CFG.lsKey, JSON.stringify(salida)); } catch (e) {}
    }

    // ── Pintado ───────────────────────────────────────────────────────────
    var PILL = { listo: 'Listo', cambios: 'Con notas' };

    // `inicial` solo es true en el primer pintado: ahí sí se vuelca la nota
    // guardada en el cuadro de texto. Después no, para no pisar lo que se
    // esté escribiendo.
    function pintar(ficha, inicial) {
      var r = estado[ficha.dataset.rvKey] || {};
      var marcado = r.estado || '';
      ficha.dataset.rvState = marcado || 'sin';
      ficha.classList.toggle('rv-has', !!marcado);

      ficha.querySelectorAll('[data-rv-set]').forEach(function (b) {
        b.classList.toggle('on', b.dataset.rvSet === marcado && marcado !== '');
      });

      if (inicial) {
        var fi0 = ficha.querySelector('[data-rv-fecha]');
        if (fi0 && (r.fecha_prevista || '') !== fi0.value) fi0.value = r.fecha_prevista || '';
      }
      ficha.classList.toggle('rv-sin-fecha', marcado === 'listo' && !(r.fecha_prevista || ''));

      var pill = ficha.querySelector('[data-rv-pill]');
      if (pill) {
        if (marcado) {
          pill.hidden = false;
          pill.textContent = PILL[marcado];
          pill.className = 'rv-pill is-' + marcado;
        } else {
          pill.hidden = true;
        }
      }

      var wrap = ficha.querySelector('[data-rv-note-wrap]');
      if (wrap) wrap.hidden = marcado !== 'cambios';

      if (inicial) {
        var ta = ficha.querySelector('[data-rv-note]');
        if (ta && (r.nota || '') !== ta.value) ta.value = r.nota || '';
      }
    }

    function contar() {
      var c = { listo: 0, cambios: 0, sin: 0 };
      fichas.forEach(function (f) {
        var e = (estado[f.dataset.rvKey] || {}).estado;
        if (e === 'listo') c.listo++;
        else if (e === 'cambios') c.cambios++;
        else c.sin++;
      });
      Object.keys(c).forEach(function (k) {
        var el = document.querySelector('[data-rv-count="' + k + '"]');
        if (el) el.textContent = c[k];
      });
    }

    var bar = document.getElementById('rv-bar');
    var barText = document.getElementById('rv-bar-text');

    function actualizarBarra() {
      var n = Object.keys(sucio).length;
      var marcadas = Object.keys(estado).filter(function (k) {
        return estado[k] && estado[k].estado;
      }).length;
      var hay = !!(n || marcadas);
      document.body.classList.toggle('rv-bar-on', hay);
      bar.hidden = !hay;
      if (!hay) return;
      var sinFecha = document.querySelectorAll('[data-rv-item].rv-sin-fecha').length;
      var aviso = sinFecha
        ? ' · ' + sinFecha + (sinFecha === 1 ? ' aprobado sin fecha' : ' aprobados sin fecha')
        : '';
      barText.textContent = (n
        ? n + (n === 1 ? ' marca sin subir' : ' marcas sin subir') +
          '. Se guardan en este navegador; súbelas para que yo pueda leerlas.'
        : 'Todo subido al repositorio.') + aviso;
    }

    function avisarCambio() {
      contar();
      actualizarBarra();
      document.dispatchEvent(new CustomEvent('rv:change'));
    }

    // ── Interacción ───────────────────────────────────────────────────────
    document.addEventListener('click', function (ev) {
      var b = ev.target.closest('[data-rv-set]');
      if (!b) return;
      var ficha = b.closest('[data-rv-item]');
      if (!ficha) return;
      ev.preventDefault();
      var k = ficha.dataset.rvKey;
      var quiere = b.dataset.rvSet;
      var actual = (estado[k] || {}).estado || '';
      var nuevo = quiere === actual ? '' : quiere;
      var ta = ficha.querySelector('[data-rv-note]');
      var fi = ficha.querySelector('[data-rv-fecha]');

      estado[k] = {
        estado: nuevo,
        nota: nuevo === 'cambios' && ta ? ta.value : '',
        fecha_prevista: fi ? fi.value : (estado[k] || {}).fecha_prevista || '',
        titulo: ficha.dataset.rvTitle || '',
        fecha: new Date().toISOString(),
      };
      sucio[k] = true;
      persistir();
      pintar(ficha);
      avisarCambio();
      if (nuevo === 'cambios' && ta) ta.focus();
    });

    // La fecha es un <input type="date">: se guarda en cuanto cambia.
    document.addEventListener('change', function (ev) {
      var fi = ev.target.closest('[data-rv-fecha]');
      if (!fi) return;
      var fichaF = fi.closest('[data-rv-item]');
      if (!fichaF) return;
      var kf = fichaF.dataset.rvKey;
      estado[kf] = Object.assign({}, estado[kf], {
        fecha_prevista: fi.value,
        titulo: fichaF.dataset.rvTitle || '',
        fecha: new Date().toISOString(),
      });
      sucio[kf] = true;
      persistir();
      pintar(fichaF);
      avisarCambio();
    });

    var temporizador;
    document.addEventListener('input', function (ev) {
      var ta = ev.target.closest('[data-rv-note]');
      if (!ta) return;
      var ficha = ta.closest('[data-rv-item]');
      if (!ficha) return;
      var k = ficha.dataset.rvKey;
      clearTimeout(temporizador);
      temporizador = setTimeout(function () {
        estado[k] = Object.assign({}, estado[k], {
          estado: 'cambios',
          nota: ta.value,
          titulo: ficha.dataset.rvTitle || '',
          fecha: new Date().toISOString(),
        });
        sucio[k] = true;
        persistir();
        actualizarBarra();
      }, 400);
    });

    // ── Avisos ────────────────────────────────────────────────────────────
    var toastEl = document.getElementById('rv-toast');
    var toastT;
    function toast(m, ms) {
      toastEl.textContent = m;
      toastEl.classList.add('show');
      clearTimeout(toastT);
      toastT = setTimeout(function () { toastEl.classList.remove('show'); }, ms || 3200);
    }

    // ── Copiar las notas, por si prefieres pegarlas en la conversación ─────
    document.getElementById('rv-copy').addEventListener('click', async function () {
      var lineas = [];
      fichas.forEach(function (f) {
        var r = estado[f.dataset.rvKey];
        if (!r || !r.estado) return;
        lineas.push(
          (r.estado === 'listo' ? '✓ LISTO' : '✎ CAMBIOS') + ' · ' + (f.dataset.rvTitle || f.dataset.rvKey) +
          (r.fecha_prevista ? '   [publicar el ' + r.fecha_prevista + ']' : '') +
          (r.nota && r.nota.trim() ? '\n   ' + r.nota.trim() : '')
        );
      });
      var texto = lineas.length
        ? 'Revisión · ' + CFG.path + '\n\n' + lineas.join('\n\n')
        : 'Todavía no has marcado ningún ' + CFG.unidad + '.';
      try {
        await navigator.clipboard.writeText(texto);
        toast('Notas copiadas.');
      } catch (e) {
        toast('No se pudo copiar; están en la consola.');
        console.log(texto);
      }
    });

    // ── Guardar en el repositorio ──────────────────────────────────────────
    // La mecánica (login, lectura, fusión y reintento) vive en /kit/gh.js,
    // compartida con el calendario.
    var DESTINO = { repo: CFG.repo, path: CFG.path, branch: CFG.branch };

    document.getElementById('rv-save').addEventListener('click', async function () {
      var btn = this;
      var antes = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Guardando…';
      try {
        await ADAR_GH.guardarRevisiones(DESTINO, estado);
        sucio = {};
        persistir();
        actualizarBarra();
        toast('Guardado. Lo leeré de ' + CFG.path + '.', 4200);
      } catch (e) {
        toast('No se pudo guardar: ' + (e.message || e), 6000);
      } finally {
        btn.disabled = false;
        btn.textContent = antes;
      }
    });

    // Puerta para que otras partes de la página (el editor de textos del kit)
    // escriban en la misma revisión, en vez de tocar localStorage por su cuenta
    // y pisarse con esta.
    window.ADAR_REV = {
      obtener: function (k) { return Object.assign({}, estado[k] || {}); },
      guardar: function (k, cambios, titulo) {
        estado[k] = Object.assign({}, estado[k], cambios, {
          titulo: titulo || (estado[k] || {}).titulo || '',
          fecha: new Date().toISOString(),
        });
        sucio[k] = true;
        persistir();
        var ficha = document.querySelector('[data-rv-item][data-rv-key="' + (window.CSS && CSS.escape ? CSS.escape(k) : k) + '"]');
        if (ficha) pintar(ficha);
        avisarCambio();
      },
    };

    fichas.forEach(function (f) { pintar(f, true); });
    contar();
    actualizarBarra();
  })();
</script>
