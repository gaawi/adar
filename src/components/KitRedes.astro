        }
        async function ensureFonts() {
          if (!document.fonts || !document.fonts.load) return;
          try {
            await Promise.all(B.fontLoads.map(function (f) { return document.fonts.load(f); }));
          } catch (e) {}
        }
        var DISPLAY = B.display;  // titulares · voz
        var UI = B.ui;            // cuerpo
        var LABEL = B.label;      // rótulos · dato
        var TW = B.titleWeight;   // peso de los titulares

        function label(ctx, size, color, spacing) {
          ctx.font = B.labelWeight + ' ' + size + 'px ' + LABEL;
          ctx.fillStyle = color;
          try { ctx.letterSpacing = (spacing || 0) + 'px'; } catch (e) {}
        }
        function resetSpacing(ctx) { try { ctx.letterSpacing = '0px'; } catch (e) {} }

        // ── Dibujo de una diapositiva ────────────────────────────────────
        // Dibuja la foto recortada "cover" dentro de un rectángulo.
        // fx/fy (0-1) son el punto de la foto que queda centrado en el recorte:
        // 0.5/0.5 es el centro geométrico, valores menores desplazan el
        // encuadre hacia la izquierda o hacia arriba.
        async function drawPhoto(ctx, src, x, y, w, h, fx, fy) {
          if (!src) return false;
          fx = typeof fx === 'number' ? fx : 0.5;
          fy = typeof fy === 'number' ? fy : 0.5;
          try {
            var img = await loadImage(src);
            var s = Math.max(w / img.naturalWidth, h / img.naturalHeight);
            var dw = img.naturalWidth * s, dh = img.naturalHeight * s;
            // Sin salirse: el desplazamiento se limita al sobrante del recorte.
            var ox = Math.min(0, Math.max(w - dw, -(dw - w) * fx));
            var oy = Math.min(0, Math.max(h - dh, -(dh - h) * fy));
            ctx.save();
            ctx.beginPath(); ctx.rect(x, y, w, h); ctx.clip();
            ctx.drawImage(img, x + ox, y + oy, dw, dh);
            ctx.restore();
            return true;
          } catch (e) { return false; }
        }

        async function drawSlide(canvas, post, slide, idx, total, fmt, withOverlay, style, opts) {
          style = style || 'cinta';
          opts = opts || {};
          var photo = opts.image || post.image;
          var fx = typeof opts.fx === 'number' ? opts.fx : 0.5;
          var fy = typeof opts.fy === 'number' ? opts.fy : 0.5;
          var spec = SIZES[fmt], W = spec[0], H = spec[1];
          canvas.width = W; canvas.height = H;
          var ctx = canvas.getContext('2d');
          await ensureFonts();
          var pad = Math.round(W * 0.085);
          var labelSize = Math.max(13, Math.round(W * 0.019));
          // El 9:16 va a Stories y a TikTok con el mismo archivo. TikTok tapa
          // más abajo que Instagram (pie, usuario y música ocupan cerca de un
          // quinto), así que el margen se calcula para la peor de las dos: así
          // no hay que generar dos versiones.
          var safeBottom = fmt === 'story' ? Math.round(H * 0.18) : 0;
          var safeTop = fmt === 'story' ? Math.round(H * 0.09) : 0;
          // El carril de botones de TikTok (me gusta, comentarios, compartir)
          // se come la banda derecha. En Instagram no hay nada ahí, pero el
          // archivo es el mismo, así que el texto se queda a este lado.
          var safeRight = fmt === 'story' ? Math.round(W * 0.16) : 0;

          if (slide.type === 'cover') {
            ctx.fillStyle = B.ink; ctx.fillRect(0, 0, W, H);

            // ── Estilo "bloque": foto arriba, franja sólida abajo ──────────
            if (style === 'bloque') {
              var bandH = Math.round(H * (fmt === 'story' ? 0.42 : 0.46));
              await drawPhoto(ctx, photo, 0, 0, W, H - bandH, fx, fy);
              if (!withOverlay) return;
              ctx.fillStyle = B.ink; ctx.fillRect(0, H - bandH, W, bandH);
              ctx.fillStyle = B.accent;
              ctx.fillRect(0, H - bandH, W, Math.max(5, Math.round(W * 0.009)));

              var bTop = H - bandH + Math.round(pad * 0.75);
              label(ctx, labelSize, B.accent, Math.round(labelSize * 0.16));
              ctx.fillText(B.stamp, pad, bTop + labelSize);
              resetSpacing(ctx);
              var bAvail = bandH - Math.round(pad * 0.75) - labelSize * 3.4 - safeBottom;
              var bfit = fitLines(ctx, slide.title, W - pad * 2 - safeRight, bAvail, TW, DISPLAY, Math.round(W * 0.070), Math.round(W * 0.032));
              ctx.font = TW + ' ' + bfit.size + 'px ' + DISPLAY; ctx.fillStyle = B.paper;
              var byy = bTop + labelSize * 2.6 + bfit.size * 0.86;
              for (var bi = 0; bi < bfit.lines.length; bi++) ctx.fillText(bfit.lines[bi], pad, byy + bi * bfit.size * 1.12);
              label(ctx, labelSize, rgba(B.paper, 0.6), 0);
