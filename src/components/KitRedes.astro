            var qH = qf.lines.length * qf.size * 1.16;
            var markSize = Math.round(W * 0.20);
            var qTotal = markSize * 0.42 + qH;
            var qTop = areaTop + Math.max(0, (areaH - qTotal) / 2);

            ctx.font = TW + ' ' + markSize + 'px ' + DISPLAY;
            ctx.fillStyle = rgba(B.accent, 0.22);
