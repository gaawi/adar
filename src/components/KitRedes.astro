        function closeAdapter() {
          modal.classList.remove('open');
          document.body.style.overflow = '';
        }
        var TYPE_LABEL = { cover: 'Portada', text: 'Texto', quote: 'Cita', cta: 'Cierre' };

        function renderList() {
          elSlides.innerHTML = '';
          M.slides.forEach(function (s, i) {
            var d = document.createElement('div');
            d.className = 'slide-item' + (i === M.sel ? ' sel' : '');
            d.dataset.i = i;
            var titleLimit = s.type === 'cover' ? 95 : 70;
            var bodyLimit = 300;
            d.innerHTML =
              '<div class="slide-top">' +
                '<span class="slide-n">' + String(i + 1).padStart(2, '0') + '</span>' +
                '<span class="slide-type">' + (TYPE_LABEL[s.type] || s.type) + '</span>' +
                '<span class="slide-tools">' +
                  '<button data-up="' + i + '" title="Subir">↑</button>' +
                  '<button data-down="' + i + '" title="Bajar">↓</button>' +
                  '<button data-del="' + i + '" title="Eliminar">✕</button>' +
                '</span>' +
              '</div>' +
              '<input data-f="title" data-i="' + i + '" value="" />' +
              '<div class="chars" data-c="title-' + i + '"></div>' +
              (s.type === 'cover' ? '' :
                '<textarea data-f="body" data-i="' + i + '" rows="3"></textarea>' +
                '<div class="chars" data-c="body-' + i + '"></div>');
            elSlides.appendChild(d);
            d.querySelector('[data-f="title"]').value = s.title || '';
            var bt = d.querySelector('[data-f="body"]');
            if (bt) bt.value = s.body || '';
            updateChars(i, 'title', (s.title || '').length, titleLimit);
            if (bt) updateChars(i, 'body', (s.body || '').length, bodyLimit);
          });
        }
        function updateChars(i, field, len, limit) {
          var el = elSlides.querySelector('[data-c="' + field + '-' + i + '"]');
          if (!el) return;
          el.textContent = len + ' / ' + limit;
          el.classList.toggle('over', len > limit);
        }

        var previewToken = 0;
        async function renderPreview() {
          var my = ++previewToken;
          var s = M.slides[M.sel];
          if (!s) return;
          elHint.textContent = 'Generando…';
          try {
            await drawSlide(elCanvas, M.post, s, M.sel, M.slides.length, M.fmt, document.getElementById('overlay').checked, M.style, photoOpts());
            renderStyleThumbs();
            syncPhotoTools();
            if (my !== previewToken) return;
            elHint.textContent = 'Diapositiva ' + (M.sel + 1) + ' de ' + M.slides.length +
              ' · ' + SIZES[M.fmt][0] + '×' + SIZES[M.fmt][1];
          } catch (e) {
            if (my !== previewToken) return;
            elHint.textContent = 'No se pudo generar: ' + e.message;
          }
        }

        elSlides.addEventListener('input', function (ev) {
          var el = ev.target;
          var i = parseInt(el.dataset.i, 10);
          if (isNaN(i)) return;
          var f = el.dataset.f;
          M.slides[i][f] = el.value;
          var limit = f === 'title' ? (M.slides[i].type === 'cover' ? 95 : 70) : 300;
          updateChars(i, f, el.value.length, limit);
          if (i === M.sel) renderPreview();
        });
        elSlides.addEventListener('click', function (ev) {
          var b = ev.target.closest('button');
          if (b) {
            var iu = b.dataset.up, idn = b.dataset.down, idel = b.dataset.del;
            if (iu !== undefined) { var i1 = +iu; if (i1 > 0) { var tmp = M.slides[i1 - 1]; M.slides[i1 - 1] = M.slides[i1]; M.slides[i1] = tmp; M.sel = i1 - 1; renderList(); renderPreview(); } return; }
            if (idn !== undefined) { var i2 = +idn; if (i2 < M.slides.length - 1) { var t2 = M.slides[i2 + 1]; M.slides[i2 + 1] = M.slides[i2]; M.slides[i2] = t2; M.sel = i2 + 1; renderList(); renderPreview(); } return; }
            if (idel !== undefined) {
              if (M.slides.length <= 1) { toast('Tiene que quedar al menos una diapositiva.'); return; }
              M.slides.splice(+idel, 1);
              if (M.sel >= M.slides.length) M.sel = M.slides.length - 1;
              renderList(); renderPreview(); return;
            }
          }
          var item = ev.target.closest('.slide-item');
          if (item && ev.target.tagName !== 'INPUT' && ev.target.tagName !== 'TEXTAREA') {
            M.sel = +item.dataset.i; renderList(); renderPreview();
          }
          if (ev.target.tagName === 'INPUT' || ev.target.tagName === 'TEXTAREA') {
            var it = ev.target.closest('.slide-item');
            if (it && +it.dataset.i !== M.sel) { M.sel = +it.dataset.i; renderList(); renderPreview(); }
          }
        });

        // Dibuja las tres opciones de diseño de la diapositiva actual.
        var thumbToken = 0;
        async function renderStyleThumbs() {
          var my = ++thumbToken;
          var slide = M.slides[M.sel];
          if (!slide) return;
          var btns = document.querySelectorAll('#m-styles button');
          for (var i = 0; i < btns.length; i++) {
            var btn = btns[i];
            var st = btn.dataset.style;
            btn.classList.toggle('on', st === M.style);
            try {
              await drawSlide(btn.querySelector('canvas'), M.post, slide, M.sel, M.slides.length,
                M.fmt, document.getElementById('overlay').checked, st, photoOpts());
            } catch (e) { /* si falla la foto, la miniatura queda vacía */ }
            if (my !== thumbToken) return;
          }
        }

        document.getElementById('m-styles').addEventListener('click', function (e) {
          var b = e.target.closest('button'); if (!b) return;
          M.style = b.dataset.style;
          quickStyle = M.style;
          document.querySelectorAll('#styleSeg button').forEach(function (x) {
            x.classList.toggle('on', x.dataset.style === M.style);
          });
          renderPreview();
        });

        // Selector de la barra superior (para las descargas rápidas de portada).
        document.getElementById('styleSeg').addEventListener('click', function (e) {
          var b = e.target.closest('button'); if (!b) return;
          quickStyle = b.dataset.style;
          document.querySelectorAll('#styleSeg button').forEach(function (x) { x.classList.toggle('on', x === b); });
          if (modal.classList.contains('open')) { M.style = quickStyle; renderPreview(); }
        });

        function photoOpts() {
          return { image: M.image || undefined, fx: M.fx, fy: M.fy };
        }

        // Los controles de foto solo aplican a la portada, que es la única
        // diapositiva con imagen; en las de texto se atenúan.
        function syncPhotoTools() {
          var isCover = (M.slides[M.sel] || {}).type === 'cover';
          document.getElementById('m-photo').classList.toggle('is-off', !isCover);
          document.getElementById('m-photo-hint').textContent = isCover
            ? (M.image ? 'Usando una foto tuya.' : 'Arrastra para mover el centro de la foto.')
            : 'Esta diapositiva no lleva foto.';
        }

        document.getElementById('m-photo-pick').addEventListener('click', function () {
          document.getElementById('m-photo-file').click();
        });
        document.getElementById('m-photo-file').addEventListener('change', function (ev) {
          var f = ev.target.files && ev.target.files[0];
          if (!f) return;
          if (M.image && M.image.startsWith('blob:')) URL.revokeObjectURL(M.image);
          M.image = URL.createObjectURL(f);
          // Una foto nueva parte del centro.
          M.fx = 0.5; M.fy = 0.5;
          document.getElementById('m-fx').value = 50;
          document.getElementById('m-fy').value = 50;
          ev.target.value = '';
          renderPreview();
        });
        document.getElementById('m-photo-reset').addEventListener('click', function () {
          if (M.image && M.image.startsWith('blob:')) URL.revokeObjectURL(M.image);
          M.image = null; M.fx = 0.5; M.fy = 0.5;
          document.getElementById('m-fx').value = 50;
          document.getElementById('m-fy').value = 50;
          renderPreview();
        });
        ['m-fx', 'm-fy'].forEach(function (id) {
          document.getElementById(id).addEventListener('input', function (e) {
            if (id === 'm-fx') M.fx = e.target.value / 100; else M.fy = e.target.value / 100;
            renderPreview();
          });
        });

        document.getElementById('m-close').addEventListener('click', closeAdapter);
        modal.addEventListener('click', function (e) { if (e.target === modal) closeAdapter(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('open')) closeAdapter(); });

        document.getElementById('m-format').addEventListener('click', function (e) {
          var b = e.target.closest('button'); if (!b) return;
          M.fmt = b.dataset.fmt;
          document.querySelectorAll('#m-format button').forEach(function (x) { x.classList.toggle('on', x === b); });
          renderPreview();
        });
        document.getElementById('m-add').addEventListener('click', function () {
          var at = Math.max(1, M.sel + 1);
          M.slides.splice(at, 0, { type: 'text', title: B.newSlide.title, body: B.newSlide.body });
          M.sel = at; renderList(); renderPreview();
        });
        document.getElementById('m-add-quote').addEventListener('click', function () {
          var at = Math.max(1, M.sel + 1);
          M.slides.splice(at, 0, { type: 'quote', title: B.newQuote.title, body: B.newQuote.body });
          M.sel = at; renderList(); renderPreview();
        });
        document.getElementById('m-reset').addEventListener('click', function () {
          M.slides = JSON.parse(JSON.stringify(M.post.slides));
          M.sel = 0; renderList(); renderPreview();
          toast('Textos restaurados.');
        });
        document.getElementById('m-copy').addEventListener('click', async function () {
          var ok = await copy(textoDe(M.post, 'ig'));
          if (ok) flash(this, 'Copiado ✓'); else toast('No se pudo copiar.');
        });
        document.getElementById('m-dl-one').addEventListener('click', async function () {
          var btn = this; btn.classList.add('is-busy');
          try {
            var c = document.createElement('canvas');
            await drawSlide(c, M.post, M.slides[M.sel], M.sel, M.slides.length, M.fmt, document.getElementById('overlay').checked, M.style, photoOpts());
            var blob = await canvasToBlob(c);
            saveBlob(blob, fileName(M.post.slug, [SIZES[M.fmt][2], M.style, String(M.sel + 1).padStart(2, '0')]) + '.jpg');
            flash(btn, 'Descargada ✓');
          } catch (e) { btn.classList.remove('is-busy'); toast('Error: ' + e.message); }
        });
        document.getElementById('m-dl-all').addEventListener('click', async function () {
          var btn = this; btn.classList.add('is-busy');
          var prev = btn.textContent;
          try {
            for (var i = 0; i < M.slides.length; i++) {
              btn.textContent = 'Generando ' + (i + 1) + '/' + M.slides.length + '…';
              var c = document.createElement('canvas');
              await drawSlide(c, M.post, M.slides[i], i, M.slides.length, M.fmt, document.getElementById('overlay').checked, M.style, photoOpts());
              var blob = await canvasToBlob(c);
              saveBlob(blob, fileName(M.post.slug, [SIZES[M.fmt][2], M.style, String(i + 1).padStart(2, '0')]) + '.jpg');
              await new Promise(function (r) { setTimeout(r, 320); });
            }
            btn.classList.remove('is-busy'); btn.textContent = prev;
            toast(M.slides.length + ' imágenes descargadas, numeradas en orden.');
          } catch (e) {
            btn.classList.remove('is-busy'); btn.textContent = prev;
            toast('Error al generar: ' + e.message);
          }
        });

        // ── Botones de las tarjetas ──────────────────────────────────────
        document.addEventListener('click', async function (ev) {
          var btn = ev.target.closest('button');
          if (!btn || btn.closest('#modal')) return;
          var card = btn.closest('.card');
          if (!card) return;
          var d = POSTS[+card.dataset.i];
          var withOverlay = document.getElementById('overlay').checked;

          // ── Atajo para publicar ────────────────────────────────────────
          // Va lo primero y sin `await` por delante: window.open tiene que
          // caer dentro del gesto del clic o el navegador lo bloquea.
          // Ninguna de las tres redes admite el texto en el enlace, así que se
          // deja en el portapapeles y se abre su página. X sí lo admite.
          if (btn.dataset.fold !== undefined) {
            var plegada = card.classList.toggle('is-folded');
            btn.setAttribute('aria-expanded', plegada ? 'false' : 'true');
            return;
          }

          if (btn.dataset.rvIr) {
            var red = btn.dataset.rvIr;
            var texto = textoDe(d, red);
            if (red === 'x') {
              window.open('https://x.com/intent/post?text=' + encodeURIComponent(texto), '_blank', 'noopener');
              flash(btn, 'Abierto ↗');
              return;
            }
            // El escribir arranca ya, con el documento todavía enfocado; la
            // ventana se abre en este mismo tick.
            var copiando = navigator.clipboard && navigator.clipboard.writeText
              ? navigator.clipboard.writeText(texto)
              : Promise.reject();
            window.open(btn.dataset.rvIrHref, '_blank', 'noopener');
            copiando.then(
              function () { flash(btn, 'Copiado ✓'); },
              function () { copy(texto); flash(btn, 'Copiado ✓'); }
            );
            return;
          }

          if (btn.dataset.adapt) { openAdapter(d, btn.dataset.adapt); return; }

          var dl = btn.dataset.dl;
          if (dl) {
            if (dl === 'txt') {
              var txt = d.title + '\n\n' + (d.excerpt ? d.excerpt + '\n\n' : '') + d.plainFull + '\n\n' + d.url + '\n';
              saveBlob(new Blob([txt], { type: 'text/plain;charset=utf-8' }), fileName(d.slug, ['texto']) + '.txt');
              flash(btn, 'Descargado ✓'); return;
            }
            if (!d.image) { toast('Esta ficha no tiene imagen destacada.'); return; }
            if (dl === 'orig') {
              btn.classList.add('is-busy');
              try {
                var resp = await fetch(d.image, { mode: 'cors' });
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                var b0 = await resp.blob();
                var ext = (d.image.split('.').pop() || 'jpg').split(/[?#]/)[0].slice(0, 4);
                saveBlob(b0, fileName(d.slug, ['original']) + '.' + ext);
                flash(btn, 'Descargado ✓');
              } catch (e) {
                btn.classList.remove('is-busy');
                window.open(d.image, '_blank', 'noopener');
                toast('Se abrió en otra pestaña: guárdala desde ahí.');
              }
              return;
            }
            btn.classList.add('is-busy');
            try {
              var cc = document.createElement('canvas');
              await drawSlide(cc, d, { type: 'cover', title: d.title, body: '' }, 0, 1, dl, withOverlay, quickStyle);
              var bb = await canvasToBlob(cc);
              saveBlob(bb, fileName(d.slug, [SIZES[dl][2], quickStyle]) + '.jpg');
              flash(btn, 'Descargado ✓');
            } catch (e) { btn.classList.remove('is-busy'); toast('No se pudo generar: ' + e.message); }
            return;
          }

          if (btn.dataset.textos !== undefined) { abrirTextos(d); return; }

          var cp = btn.dataset.copy;
          if (cp) {
            // 'url' no se edita; el resto usa lo que haya escrito a mano.
            var ok = await copy(cp === 'url' ? captions(d).url : textoDe(d, cp));
            if (ok) flash(btn, 'Copiado ✓'); else toast('No se pudo copiar.');
            return;
          }
        });

        // ── Editor de textos por red ─────────────────────────────────────
        var tmodal = document.getElementById('tmodal');
        var tbody = document.getElementById('t-body');
        var tActual = null;
        var tGuardar;

        function estadoTextos(d) {
          var t = (window.ADAR_REV ? ADAR_REV.obtener(claveDe(d)).textos : null) || {};
          var n = REDES.filter(function (r) { return (t[r.id] || '').trim(); }).length;
          return n ? n + (n === 1 ? ' texto escrito a mano' : ' textos escritos a mano') : 'Todos automáticos';
        }

        function pintaCuenta(caja) {
          var ta = caja.querySelector('textarea');
          var el = caja.querySelector('.t-cuenta');
          var limite = Number(caja.dataset.limite);
          var n = ta.value.length;
          el.textContent = n.toLocaleString('es-ES') + ' / ' + limite.toLocaleString('es-ES');
          el.classList.toggle('pasa', n > limite);
        }

        function abrirTextos(d) {
          tActual = d;
          document.getElementById('t-title').textContent = d.title;
          var timg = document.getElementById('t-img');
          if (d.image) { timg.src = d.image; timg.hidden = false; }
          else { timg.removeAttribute('src'); timg.hidden = true; }
          tbody.innerHTML = '';
          REDES.forEach(function (r) {
            var caja = document.createElement('div');
            caja.className = 't-red';
            caja.dataset.red = r.id;
            caja.dataset.limite = r.limite;
            caja.innerHTML =
              '<div class="t-lado">' +
                '<strong></strong>' +
                '<span class="pista"></span>' +
                '<span class="t-cuenta"></span>' +
                '<button type="button" data-t-copiar>Copiar</button>' +
                '<button type="button" data-t-auto>Texto automático</button>' +
              '</div>' +
              '<textarea></textarea>';
            caja.querySelector('strong').textContent = r.nombre;
            caja.querySelector('.pista').textContent = r.pista;
            caja.querySelector('textarea').value = textoDe(d, r.id);
            tbody.appendChild(caja);
            pintaCuenta(caja);
          });
          document.getElementById('t-estado').textContent = estadoTextos(d);
          tmodal.classList.add('open');
          document.body.style.overflow = 'hidden';
          // Después de abrir: con el modal oculto scrollHeight vale 0 y todos
          // los campos saldrían de una línea.
          tbody.querySelectorAll('textarea').forEach(ajustaAlto);
        }

        /** Deja el campo con la altura justa de su contenido. */
        function ajustaAlto(ta) {
          ta.style.height = 'auto';
          ta.style.height = ta.scrollHeight + 'px';
        }

        function cerrarTextos() {
          tmodal.classList.remove('open');
          document.body.style.overflow = '';
          tActual = null;
        }

        function guardaTextos() {
          if (!tActual || !window.ADAR_REV) return;
          var auto = captions(tActual);
          var textos = {};
          tbody.querySelectorAll('.t-red').forEach(function (caja) {
            var red = caja.dataset.red;
            var v = caja.querySelector('textarea').value;
            // Si coincide con el automático no se guarda: así el texto sigue
            // actualizándose solo cuando cambie el artículo.
            if (v.trim() && v !== auto[red]) textos[red] = v;
          });
          ADAR_REV.guardar(claveDe(tActual), { textos: textos }, tActual.title);
          document.getElementById('t-estado').textContent = estadoTextos(tActual);
        }

        tbody.addEventListener('input', function (ev) {
          var caja = ev.target.closest('.t-red');
          if (!caja) return;
          ajustaAlto(caja.querySelector('textarea'));
          pintaCuenta(caja);
          clearTimeout(tGuardar);
          tGuardar = setTimeout(guardaTextos, 400);
        });

        tbody.addEventListener('click', async function (ev) {
          var caja = ev.target.closest('.t-red');
          if (!caja) return;
          var ta = caja.querySelector('textarea');
          if (ev.target.closest('[data-t-copiar]')) {
            var ok = await copy(ta.value);
            if (ok) flash(ev.target.closest('button'), 'Copiado ✓'); else toast('No se pudo copiar.');
            return;
          }
          if (ev.target.closest('[data-t-auto]')) {
            ta.value = captions(tActual)[caja.dataset.red];
            ajustaAlto(ta);
            pintaCuenta(caja);
            guardaTextos();
          }
        });

        document.getElementById('t-reset').addEventListener('click', function () {
          if (!tActual) return;
          var auto = captions(tActual);
          tbody.querySelectorAll('.t-red').forEach(function (caja) {
            var ta0 = caja.querySelector('textarea');
            ta0.value = auto[caja.dataset.red];
            ajustaAlto(ta0);
            pintaCuenta(caja);
          });
          guardaTextos();
          toast('Textos automáticos restaurados.');
        });

        document.getElementById('t-close').addEventListener('click', cerrarTextos);
        tmodal.addEventListener('click', function (e) { if (e.target === tmodal) cerrarTextos(); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && tmodal.classList.contains('open')) cerrarTextos();
        });

        // ── Filtros ──────────────────────────────────────────────────────
        var q = document.getElementById('q'), onlyPub = document.getElementById('onlyPub'), countEl = document.getElementById('count');
        var revFilter = 'all', pubFilter = 'all', tipoFilter = 'all';
        function applyFilter() {
          var term = (q.value || '').trim().toLowerCase(), pubOnly = onlyPub.checked, shown = 0;
          document.querySelectorAll('.card').forEach(function (card) {
            // data-rv-state y data-rv-pub-state los escribe RevisionBar; aquí
            // solo se combinan con los filtros propios del kit.
            var show =
              (!term || card.dataset.title.indexOf(term) > -1) &&
              (!pubOnly || card.dataset.status === 'publish') &&
              (pubFilter === 'all' || card.dataset.rvPubState === pubFilter) &&
              (tipoFilter === 'all' || card.dataset.kind === tipoFilter) &&
              (revFilter === 'all' || card.dataset.rvState === revFilter);
            card.classList.toggle('is-hidden', !show);
            if (show) shown++;
          });
          countEl.textContent = shown + ' ' + (shown === 1 ? B.unit.one : B.unit.many) + ' a la vista';
        }
        q.addEventListener('input', applyFilter);
        onlyPub.addEventListener('change', applyFilter);

        // Vista compacta: pliega o despliega todas a la vez. Se recuerda,
        // porque quien entra a repasar suele querer siempre la misma.
        var plegarTodo = document.getElementById('plegarTodo');
        var todoPlegado = false;
        function aplicaPlegado() {
          document.querySelectorAll('.card').forEach(function (c) {
            c.classList.toggle('is-folded', todoPlegado);
            var f = c.querySelector('[data-fold]');
            if (f) f.setAttribute('aria-expanded', todoPlegado ? 'false' : 'true');
          });
          // El botón dice lo que va a hacer, no en qué estado está.
          plegarTodo.textContent = todoPlegado ? 'Desplegar todas' : 'Plegar todas';
          plegarTodo.setAttribute('aria-pressed', todoPlegado ? 'true' : 'false');
          plegarTodo.classList.toggle('on', todoPlegado);
          try { localStorage.setItem('kit_compacta_' + B.id, todoPlegado ? '1' : ''); } catch (e) {}
        }
        try { todoPlegado = localStorage.getItem('kit_compacta_' + B.id) === '1'; } catch (e) {}
        aplicaPlegado();
        plegarTodo.addEventListener('click', function () {
          todoPlegado = !todoPlegado;
          aplicaPlegado();
        });
        document.getElementById('revSeg').addEventListener('click', function (e) {
          var b = e.target.closest('button'); if (!b) return;
          revFilter = b.dataset.rev;
          document.querySelectorAll('#revSeg button').forEach(function (x) { x.classList.toggle('on', x === b); });
          applyFilter();
        });
        document.getElementById('pubSeg').addEventListener('click', function (e) {
          var b = e.target.closest('button'); if (!b) return;
          pubFilter = b.dataset.pub;
          document.querySelectorAll('#pubSeg button').forEach(function (x) { x.classList.toggle('on', x === b); });
          applyFilter();
        });
        document.getElementById('tipoSeg').addEventListener('click', function (e) {
          var b = e.target.closest('button'); if (!b) return;
          tipoFilter = b.dataset.tipo;
          document.querySelectorAll('#tipoSeg button').forEach(function (x) { x.classList.toggle('on', x === b); });
          applyFilter();
        });
        // Al marcar o desmarcar hay que rehacer el filtro.
        document.addEventListener('rv:change', applyFilter);

        // ── Orden a mano ─────────────────────────────────────────────────
        // Se arrastra por el asa y se guarda con las revisiones, así que lo
        // que tú pongas arriba lo ve arriba quien entre después. Las piezas
        // sin posición guardada van detrás, en su orden natural.
        var btnFecha = document.getElementById('ordenFecha');
        if (!window.ADAR_REV) btnFecha.hidden = true;

        function clave(card) { return card.dataset.rvKey; }
        function cards() { return [].slice.call(document.querySelectorAll('.card')); }

        function hayOrdenAMano() {
          return cards().some(function (c) {
            return typeof (ADAR_REV.obtener(clave(c)).orden) === 'number';
          });
        }

        function ordenar() {
          var cs = cards();
          if (!cs.length) return;
          var conOrden = [], sinOrden = [];
          cs.forEach(function (c) {
            var o = ADAR_REV.obtener(clave(c)).orden;
            if (typeof o === 'number') conOrden.push({ c: c, o: o });
            else sinOrden.push({ c: c, o: Number(c.dataset.nat) });
          });
          conOrden.sort(function (a, b) { return a.o - b.o; });
          sinOrden.sort(function (a, b) { return a.o - b.o; });
          // Las fichas van todas seguidas, justo antes del bloque de ayuda:
          // así la cabecera se queda arriba y la ayuda al final.
          var padre = cs[0].parentNode;
          var ayuda = padre.querySelector('.help');
          conOrden.concat(sinOrden).forEach(function (x) { padre.insertBefore(x.c, ayuda); });
          btnFecha.hidden = !hayOrdenAMano();
        }

        function guardarOrden() {
          var entradas = cards().map(function (c, i) {
            return { clave: clave(c), cambios: { orden: i }, titulo: c.dataset.rvTitle || "" };
          });
          ADAR_REV.guardarVarios(entradas);
          btnFecha.hidden = false;
        }

        var arrastrada = null, desdeAsa = false;
        document.addEventListener("dragstart", function (e) {
          var card = e.target.closest(".card");
          // dragstart se dispara sobre el elemento arrastrable, que es la
          // ficha, NO sobre el asa: mirar e.target para saber si el gesto
          // empezó en el asa daba siempre que no, y cancelaba todo. Lo que
          // vale es dónde se apretó el ratón, que lo apunta `desdeAsa`.
          if (!card || !desdeAsa) { if (card) e.preventDefault(); return; }
          arrastrada = card;
          card.classList.add("is-dragging");
          e.dataTransfer.effectAllowed = "move";
          // Firefox no arranca el arrastre sin datos.
          try { e.dataTransfer.setData("text/plain", clave(card)); } catch (err) {}
        });

        document.addEventListener("dragover", function (e) {
          if (!arrastrada) return;
          var sobre = e.target.closest(".card");
          if (!sobre || sobre === arrastrada) return;
          e.preventDefault();
          e.dataTransfer.dropEffect = "move";
          var r = sobre.getBoundingClientRect();
          var antes = e.clientY < r.top + r.height / 2;
          cards().forEach(function (c) { c.classList.remove("drop-antes", "drop-despues"); });
          sobre.classList.add(antes ? "drop-antes" : "drop-despues");
        });

        document.addEventListener("drop", function (e) {
          if (!arrastrada) return;
          var sobre = e.target.closest(".card");
          if (!sobre || sobre === arrastrada) return;
          e.preventDefault();
          var r = sobre.getBoundingClientRect();
          var antes = e.clientY < r.top + r.height / 2;
          sobre.parentNode.insertBefore(arrastrada, antes ? sobre : sobre.nextSibling);
          cards().forEach(function (c) { c.classList.remove("drop-antes", "drop-despues"); });
          guardarOrden();
          toast("Orden guardado en este navegador. Súbelo para que lo vea quien publique.");
        });

        document.addEventListener("dragend", function () {
          if (arrastrada) arrastrada.classList.remove("is-dragging");
          cards().forEach(function (c) { c.classList.remove("drop-antes", "drop-despues"); });
          // Durante un arrastre nativo no llega pointerup, así que la bandera
          // se limpia aquí o el siguiente gesto se daría por bueno.
          arrastrada = null;
          desdeAsa = false;
          armar(null);
        });

        btnFecha.addEventListener("click", function () {
          ADAR_REV.guardarVarios(cards().map(function (c) {
            return { clave: clave(c), cambios: { orden: undefined }, titulo: c.dataset.rvTitle || "" };
          }));
          cards().sort(function (a, b) { return Number(a.dataset.nat) - Number(b.dataset.nat); })
            .forEach(function (c) { c.parentNode.appendChild(c); });
          ordenar();
          toast("Vuelta al orden por fecha.");
        });

        // La ficha solo es arrastrable mientras el puntero está sobre su asa.
        // Si lo fuera siempre no se podría seleccionar un texto dentro, y si
        // se activara al apretar llegaría tarde: el navegador mira el atributo
        // al empezar el gesto, así que se arma antes, al pasar por encima.
        var armada = null;
        function armar(card) {
          if (armada === card) return;
          if (armada) armada.draggable = false;
          armada = card;
          if (card) card.draggable = true;
        }
        document.addEventListener("pointerover", function (e) {
          if (arrastrada) return;
          var g = e.target.closest("[data-grip]");
          armar(g ? g.closest(".card") : null);
        });
        document.addEventListener("pointerdown", function (e) {
          desdeAsa = !!e.target.closest("[data-grip]");
        });
        document.addEventListener("pointerup", function () { desdeAsa = false; });
        document.addEventListener("pointercancel", function () { desdeAsa = false; });

        ordenar();
      })();
    </script>
  </body>
</html>
