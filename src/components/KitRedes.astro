              if (!withOverlay) return;
              ctx.fillStyle = rgba(B.ink, 0.52); ctx.fillRect(0, 0, W, H);
              var inset = Math.round(W * 0.05);
              ctx.strokeStyle = rgba(B.accent, 0.85);
              ctx.lineWidth = Math.max(2, Math.round(W * 0.0035));
              ctx.strokeRect(inset + safeTop * 0.2, inset + safeTop, W - inset * 2 - safeTop * 0.4, H - inset * 2 - safeTop - safeBottom);

              var mAvail = H - safeTop - safeBottom;
              var mfit = fitLines(ctx, slide.title, W - pad * 2.4 - safeRight, mAvail * 0.44, TW, DISPLAY, Math.round(W * 0.078), Math.round(W * 0.034));
              ctx.textAlign = 'center';
              label(ctx, labelSize, B.accent, Math.round(labelSize * 0.18));
              var mBlockH = labelSize * 2.6 + mfit.lines.length * mfit.size * 1.12;
              var mTop = safeTop + (mAvail - mBlockH) / 2;
              ctx.fillText(B.stamp, W / 2, mTop + labelSize);
              resetSpacing(ctx);
              ctx.font = TW + ' ' + mfit.size + 'px ' + DISPLAY; ctx.fillStyle = B.overPhotoInk;
              var myy = mTop + labelSize * 2.6 + mfit.size * 0.86;
              for (var mi = 0; mi < mfit.lines.length; mi++) ctx.fillText(mfit.lines[mi], W / 2, myy + mi * mfit.size * 1.12);
              label(ctx, labelSize, rgba(B.paper, 0.75), 0);
              ctx.fillText(B.site, W / 2, H - inset - Math.round(pad * 0.35) - safeBottom);
              ctx.textAlign = 'left';
              resetSpacing(ctx);
              return;
            }

            // ── Estilo "cinta" (por defecto): degradado inferior ───────────
            await drawPhoto(ctx, photo, 0, 0, W, H, fx, fy);
            if (!withOverlay) return;
            var gTop = fmt === 'story' ? H * 0.42 : H * 0.32;
            var g = ctx.createLinearGradient(0, gTop, 0, H);
            g.addColorStop(0, rgba(B.ink, 0)); g.addColorStop(.55, rgba(B.ink, 0.72)); g.addColorStop(1, rgba(B.ink, 0.94));
            ctx.fillStyle = g; ctx.fillRect(0, gTop, W, H - gTop);

            var maxTitleH = H * (fmt === 'story' ? 0.30 : 0.34);
            var fit = fitLines(ctx, slide.title, W - pad * 2 - safeRight, maxTitleH, TW, DISPLAY, Math.round(W * 0.072), Math.round(W * 0.034));
            var lineH = Math.round(fit.size * 1.12);
            var baseY = H - pad - safeBottom;
            var startY = baseY - fit.lines.length * lineH + lineH * 0.8;

            ctx.fillStyle = B.accent;
            ctx.fillRect(pad, startY - lineH * 0.8 - Math.round(labelSize * 2.2), Math.round(W * 0.09), Math.max(3, Math.round(W * 0.005)));
            label(ctx, labelSize, B.accent, Math.round(labelSize * 0.16));
            ctx.fillText(B.stamp, pad, startY - lineH * 0.8 - Math.round(labelSize * 0.75));
            resetSpacing(ctx);

            ctx.font = TW + ' ' + fit.size + 'px ' + DISPLAY;
            ctx.fillStyle = B.overPhotoInk;
            for (var i = 0; i < fit.lines.length; i++) ctx.fillText(fit.lines[i], pad, startY + i * lineH);

            label(ctx, labelSize, rgba(B.paper, 0.72), 0);
            ctx.fillText(B.site, pad, H - Math.round(pad * 0.4) - safeBottom);
            resetSpacing(ctx);
