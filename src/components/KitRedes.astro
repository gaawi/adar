---
// Kit de redes · motor compartido (noindex).
//
// Una sola herramienta, dos marcas. La identidad entra por `brand` y el
// material por `posts`; aquí no hay nada específico de Festival ADAR ni de
// CreArtBox. Las páginas de src/pages/ solo eligen marca y material.
//
// Dos niveles de uso:
//   1) Botones rápidos: descargar la portada recortada por red y copiar el texto.
//   2) «Adaptar a Instagram»: convierte la pieza en un carrusel de varias
//      diapositivas editables, con previsualización y descarga numerada.
//
// Todo se genera en el navegador con canvas, así que las fotos tienen que
// servirse con Access-Control-Allow-Origin. Comprobado en el CDN de Bunny
// (Festival ADAR) y en creartbox.nyc (CreArtBox).
import type { KitBrand, KitPost } from '../data/kit-brands';
import { KITS } from '../data/kit-brands';
import RevisionBar from './RevisionBar.astro';
import RevisionItem from './RevisionItem.astro';

interface Props {
  brand: KitBrand;
  posts: KitPost[];
  /** Marcas de revisión ya guardadas en el repositorio. */
  revisiones?: Record<string, { estado?: string; nota?: string; titulo?: string; fecha?: string; fecha_prevista?: string }>;
}
const { brand, posts, revisiones = {} } = Astro.props;

const marcadas = { listo: 0, cambios: 0 };
posts.forEach((p) => {
  const e = revisiones[`${p.lang}/${p.slug}`]?.estado;
  if (e === 'listo') marcadas.listo++;
  else if (e === 'cambios') marcadas.cambios++;
});
const sinRevisar = posts.length - marcadas.listo - marcadas.cambios;

const published = posts.filter((p) => p.status === 'publish').length;

// Redes del checklist de «ya publicado». Las mismas cuatro para las que el kit
// genera texto; el post no está aquí porque su estado lo sabe el propio sitio.
// Una fila por red: qué imagen lleva, y adónde se va a publicar. El orden es
// el de la rutina, no el alfabético. `href` es la página desde la que se sube;
// el de X se compone con el texto dentro, así que aquí va la raíz.
const FILAS = [
  {
    id: 'ig',
    nombre: 'Instagram',
    corto: 'IG',
    href: brand.redes.ig,
    imgs: [
      { adapt: 'ig', label: 'Carrusel 1:1' },
      { dl: 'ig', label: 'Portada 1:1' },
      { dl: 'story', label: 'Story 9:16' },
    ],
  },
  {
    id: 'tt',
    nombre: 'TikTok',
    corto: 'TT',
    href: brand.redes.tt,
    // Mismo 9:16 que las stories: es el formato que pide, y los márgenes del
    // motor ya están calculados para que no lo tape ninguna de las dos.
    imgs: [
      { adapt: 'story', label: 'Carrusel 9:16' },
      { dl: 'story', label: 'Portada 9:16' },
    ],
  },
  { id: 'fb', nombre: 'Facebook', corto: 'FB', href: brand.redes.fb, imgs: [{ dl: 'fb', label: 'Portada 1200×630' }] },
  { id: 'li', nombre: 'LinkedIn', corto: 'LI', href: brand.redes.li, imgs: [{ dl: 'fb', label: 'Portada 1200×630' }] },
  { id: 'x', nombre: 'X', corto: 'X', href: 'https://x.com/', imgs: [{ dl: 'x', label: 'Portada 1600×900' }] },
];
const dataJson = JSON.stringify(posts).replace(/</g, '\\u003c');
const brandJson = JSON.stringify(brand).replace(/</g, '\\u003c');

// Fichas de la interfaz: en claro el fondo es papel y la tinta oscura; en
// oscuro se invierte. Se resuelve aquí para que el CSS de abajo sea único.
const dark = brand.theme === 'dark';
const tokens: Record<string, string> = {
  '--bg': dark ? brand.ink : brand.paper,
  '--fg': dark ? brand.paper : brand.ink,
  '--fg-soft': dark ? brand.inkSoft : brand.inkSoft,
  '--muted': brand.muted,
  '--line': brand.line,
  '--card': brand.card,
  '--stage': brand.stage,
  '--accent': brand.accent,
  '--on-accent': brand.onAccent,
  // Tinta que se pone sobre un fondo `--fg`. En claro es la señal; en oscuro
  // el fondo de la página, porque el ámbar sobre hueso no tiene contraste.
  '--pop': dark ? brand.ink : brand.accent,
  '--chip': dark ? 'rgba(242,239,232,.10)' : 'rgba(10,9,7,.08)',
  '--chip-soft': dark ? 'rgba(242,239,232,.07)' : 'rgba(10,9,7,.06)',
  '--scrim': dark ? 'rgba(7,7,6,.78)' : 'rgba(10,9,7,.62)',
  '--r-pill': brand.radius === '0' ? '0' : '999px',
  '--r-box': brand.radius === '0' ? '0' : '10px',
  '--r-sm': brand.radius === '0' ? '0' : '6px',
  // Los controles de revisión heredan la forma y buscan contraste sobre el
  // fondo real: el verde y el ámbar oscuros no se leen sobre sala.
  '--rv-radius': brand.radius === '0' ? '0' : '999px',
  '--rv-radius-sm': brand.radius === '0' ? '0' : '6px',
  '--rv-ok': dark ? '#6FBF85' : '#2f6b3a',
  '--rv-ok-ink': dark ? '#08140c' : '#ffffff',
  '--rv-warn': dark ? '#E0A33F' : '#9a5b12',
  '--rv-warn-ink': dark ? '#1a1206' : '#ffffff',
  '--rv-scheme': dark ? 'dark' : 'light',
  // En oscuro la barra es una superficie más de la marca (--foso), no una
  // franja crema; sobre papel se queda como estaba, oscura sobre claro.
  ...(dark ? { '--rv-bar-bg': brand.card, '--rv-bar-fg': brand.paper, '--rv-bar-line': brand.line } : {}),
  '--font-display': brand.ui,
  '--font-voz': brand.display,
  // Chapa del panel: la letra de interfaz de la marca, proporcional.
  '--font-chrome': brand.ui,
  // Solo para cifras: contadores y fechas, donde el monoespaciado alinea.
  '--font-dato': brand.label,
  '--w-label': brand.labelWeight,
};
const rootCss = `:root{${Object.entries(tokens)
  .map(([k, v]) => `${k}:${v}`)
  .join(';')}}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Kit de redes · {brand.org}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={brand.fontsHref} />
    <style is:global set:html={rootCss}></style>
    <!-- is:global es imprescindible: las diapositivas del editor se crean por
         JavaScript y no llevan el atributo de ámbito que añade Astro, así que
         con estilos encapsulados se quedarían sin aplicar. -->
    <style is:global>
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-display); -webkit-font-smoothing: antialiased; }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px 96px; }

      /* ── Cabecera del panel ───────────────────────────────────────────────
         Una sola pieza fija: identidad y navegación arriba, filtros debajo.
         Es una herramienta de trabajo diario, así que no hay titular grande
         ni texto explicativo: lo que se necesita a mano es el filtro. */
      .pnl { position: sticky; top: 0; z-index: 30; background: var(--bg); border-bottom: 1px solid var(--line); margin-bottom: 22px; }
      .pnl-top { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 12px 0 11px; }
      .pnl-titulo { font-family: var(--font-chrome); font-weight: var(--w-label); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
      .pnl-link { font-family: var(--font-chrome); font-weight: var(--w-label); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; padding: 8px 14px; text-decoration: none; color: var(--muted); border: 1px solid var(--line); border-radius: var(--r-pill); }
      .pnl-link:hover { color: var(--fg); background: var(--chip-soft); }
      /* El logotipo cierra la fila por la derecha: es la señal de en qué kit
         estás, y por eso va pegado al borde y no se mueve. */
      .pnl-logo { margin-left: auto; height: 36px; width: auto; max-width: 160px; display: block; object-fit: contain; object-position: right center; }
      /* En móvil los filtros ocupan cuatro filas: fija son 350px de pantalla
         comida, así que ahí la cabecera se va con el scroll. */
      @media (max-width: 860px) { .pnl { position: static; } }

      /* Selector de kit: siempre visible, para no confundir una marca con la otra. */
      .kit-switch { display: flex; gap: 0; margin: 0; border: 1px solid var(--line); border-radius: var(--r-pill); overflow: hidden; width: max-content; max-width: 100%; }
      .kit-switch a { font-family: var(--font-chrome); font-weight: var(--w-label); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; padding: 9px 16px; text-decoration: none; color: var(--muted); border: 0; }
      .kit-switch a + a { border-left: 1px solid var(--line); }
      .kit-switch a:hover { color: var(--fg); background: var(--chip-soft); }
      .kit-switch a.on { background: var(--fg); color: var(--bg); }

      /* Dentro de .pnl, que ya es la parte fija. */
      .toolbar { border-top: 1px solid var(--line); padding: 11px 0; display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; }
      .toolbar label { font-family: var(--font-chrome); font-size: 12px; display: flex; gap: 7px; align-items: center; cursor: pointer; }
      .toolbar input[type='search'] { font-family: var(--font-chrome); font-size: 13px; padding: 8px 12px; border: 1px solid var(--line); background: var(--card); color: var(--fg); border-radius: var(--r-pill); min-width: 210px; }
      .toolbar input[type='checkbox'] { accent-color: var(--accent); }
      .count { font-family: var(--font-chrome); font-size: 12px; color: var(--muted); margin-left: auto; }

      .card { position: relative; display: grid; grid-template-columns: 250px 1fr; gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--line); align-items: start; }
      .card-side { display: flex; flex-direction: column; gap: 12px; }

      /* ── Plegado ───────────────────────────────────────────────────────
         Plegada queda el título, los datos y poco más: así caben muchas en
         pantalla cuando lo que buscas es una en concreto. */
      /* ── Tipo de pieza ─────────────────────────────────────────────────
         «Post» lleva artículo detrás; «Solo redes» no, y su enlace va a la
         página de la que habla. Cambia lo que hay que hacer con ella. */
      .badge.tipo { border: 1px solid currentColor; background: transparent; }
      .badge.tipo.post { color: var(--fg); opacity: .55; }
      .badge.tipo.social { color: var(--accent); opacity: 1; background: var(--chip); }

      /* ── Arrastrar para ordenar ────────────────────────────────────────
         El orden a mano se guarda con las revisiones: lo urgente arriba, y
         quien entre después lo ve igual. */
      .card-grip {
        flex: 0 0 auto; display: inline-flex; align-items: center;
        align-self: stretch; padding: 0 6px 0 0;
        color: var(--muted); font-size: 15px; line-height: 1;
        cursor: grab; letter-spacing: -.1em;
        /* Sin selección: al arrastrar, el navegador intentaría coger el texto
           del asa en vez de la ficha. */
        user-select: none; -webkit-user-select: none;
      }
      .card-grip:hover { background: transparent; color: var(--fg); }
      .card-grip:active { cursor: grabbing; }
      .card.is-dragging { opacity: .35; }
      /* Dónde va a caer: un filete de acento en el borde que toca. */
      .card.drop-antes { box-shadow: 0 -3px 0 0 var(--accent); }
      .card.drop-despues { box-shadow: 0 3px 0 0 var(--accent); }

      .card-fold {
        flex: 0 0 auto; margin-left: auto;
        width: 38px; height: 38px; display: grid; place-items: center;
        border: 1px solid var(--line); background: transparent; color: var(--muted);
        padding: 0; font-size: 22px; line-height: 1; cursor: pointer;
        border-radius: var(--r-pill);
        transition: transform .15s, color .15s, border-color .15s;
      }
      .card-fold:hover { background: transparent; color: var(--fg); border-color: var(--fg); }
      .card.is-folded .card-fold { transform: rotate(-90deg); }
      .card.is-folded { padding: 10px 0; grid-template-columns: 62px 1fr; gap: 14px; align-items: center; }
      .card.is-folded .thumb { aspect-ratio: 1/1; }
      .card.is-folded .rv, .card.is-folded .note { display: none; }
      /* Plegada, de la tabla solo queda la fila de casillas: saber qué falta
         por subir es justo lo que se mira cuando se repasa la lista entera. */
      .card.is-folded .redes { display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: center; margin-top: 4px; }
      .card.is-folded .red-cab,
      .card.is-folded .red-extra,
      .card.is-folded .red-n,
      .card.is-folded .red-img,
      .card.is-folded .red-txt,
      .card.is-folded .red-ir,
      .card.is-folded .red-url { display: none; }
      .card.is-folded .red-fila { display: contents; }
      .card.is-folded .red-fila > .red-ok {
        display: inline-flex; align-items: center; gap: 4px;
        border: 0; padding: 0; min-height: 0; justify-content: flex-start;
      }
      .card.is-folded .red-corto { display: inline; }
      .card.is-folded .red-ok input { width: 13px; height: 13px; }
      .card.is-folded h2 { font-size: 16px; margin: 0 0 4px; }
      .card.is-folded .meta { margin: 0; }

      .card.is-hidden { display: none; }
      .thumb { aspect-ratio: 4/3; background: var(--chip); border-radius: var(--r-sm); overflow: hidden; display: block; position: relative; }
      .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .thumb.no-img::after { content: 'sin imagen'; position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-chrome); font-size: 11px; color: var(--muted); }
      .card h2 { font-family: var(--font-voz); font-size: 20px; line-height: 1.2; margin: 0 0 6px; letter-spacing: -.01em; display: flex; align-items: center; gap: 14px; }
      .card h2 > span { min-width: 0; }
      .meta { font-family: var(--font-dato); font-size: 11px; color: var(--muted); margin: 0 0 12px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
      .badge { padding: 2px 8px; border-radius: var(--r-pill); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
      .badge.pub { background: var(--accent); color: var(--on-accent); }
      .badge.draft { background: var(--chip); color: var(--muted); }

      /* ── Tabla de redes ────────────────────────────────────────────────
         Cinco columnas fijas: red, imagen, texto, subir y hecho. Se lee en
         horizontal, una red por fila, que es como se trabaja. */
      .redes { display: grid; grid-template-columns: 104px minmax(0, 1fr) auto auto 48px; align-items: center; column-gap: 12px; }
      .red-cab { display: contents; }
      .red-cab > span { font-family: var(--font-chrome); font-weight: var(--w-label); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); padding-bottom: 6px; border-bottom: 1px solid var(--line); }
      .red-cab > span:last-child, .red-ok { text-align: center; }
      .red-fila { display: contents; }
      .red-fila > span { padding: 7px 0; border-bottom: 1px solid var(--line-soft, rgba(128,128,128,.16)); min-height: 42px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
      .red-fila > .red-ok { justify-content: center; }
      .red-n { font-family: var(--font-chrome); font-weight: var(--w-label); font-size: 12px; }
      .red-na { font-style: normal; font-family: var(--font-chrome); font-size: 11px; color: var(--muted); }
      .red-fila button { font-size: 12px; padding: 6px 11px; }
      /* Montar abre el editor; el resto baja el archivo y ya está. Que se vea
         cuál de las dos cosas va a pasar antes de pulsar. */
      .red-fila button.es-montar { border-color: var(--accent); color: var(--fg); background: var(--chip); font-weight: 500; }
      .red-fila button.es-montar:hover { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
      .red-fila button.es-montar:disabled { border-color: var(--line); background: transparent; }
      .red-a { font-family: var(--font-chrome); font-size: 11px; line-height: 1; padding: 6px 9px; border: 1px solid var(--line); border-radius: var(--r-pill); color: var(--muted); text-decoration: none; background: transparent; cursor: pointer; white-space: nowrap; }
      .red-a:hover { color: var(--fg); border-color: var(--fg); }
      .red-ok input { accent-color: var(--accent); width: 17px; height: 17px; cursor: pointer; margin: 0; }
      .red-corto { display: none; font-family: var(--font-dato); font-size: 10px; letter-spacing: .06em; color: var(--muted); }
      .red-ok input:disabled { cursor: not-allowed; }
      /* Una red ya subida se apaga: lo que queda por hacer salta a la vista. */
      .red-fila:has(input[data-rv-pub]:checked) > span { opacity: .45; }
      .red-fila:has(input[data-rv-pub]:checked) > .red-ok { opacity: 1; }
      /* Enlace de la publicación: ocupa toda la fila, debajo de su red. */
      /* Gana a `.red-fila > span { display:flex }`, que es más específica. */
      .red-fila > .red-url { grid-column: 1 / -1; display: none; gap: 8px; align-items: center; padding: 0 0 8px; min-height: 0; border-bottom: 1px solid var(--line-soft, rgba(128,128,128,.16)); }
      /* Solo desplegada: plegada no cabe, y la regla del :has le ganaba en
         especificidad a la que oculta la tabla. */
      .card:not(.is-folded) .red-fila:has(input[data-rv-pub]:checked) > .red-url { display: flex; opacity: 1; }
      .red-url input {
        flex: 1 1 auto; min-width: 0;
        font-family: var(--font-chrome); font-size: 11px;
        padding: 5px 9px; border: 1px dashed var(--line); border-radius: var(--r-sm);
        background: transparent; color: var(--fg);
      }
      .red-url input:focus { border-style: solid; outline: none; border-color: var(--fg); }
      .red-url-ir { font-family: var(--font-chrome); font-size: 11px; color: var(--muted); text-decoration: none; white-space: nowrap; padding: 5px 8px; border: 1px solid var(--line); border-radius: var(--r-pill); }
      .red-url-ir:hover { color: var(--fg); border-color: var(--fg); }
      .red-url-ir[hidden] { display: none; }

      .red-extra { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding-top: 12px; }
      .red-extra button { font-size: 12px; padding: 6px 11px; }

      /* Revisión bajo la foto: en una columna estrecha se apila sola. */
      .rv-col { border-top: 0; margin-top: 0; padding-top: 0; }
      .rv-col .rv-choice { flex-direction: column; align-items: stretch; width: 100%; }
      .rv-col .rv-fecha { width: 100%; }
      .rv-col .rv-note { flex: 1 1 100%; }

      .group { margin-bottom: 10px; }
      .group-label { font-family: var(--font-chrome); font-weight: var(--w-label); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); display: block; margin-bottom: 6px; }
      .btns { display: flex; flex-wrap: wrap; gap: 6px; }
      button, a.btn { font-family: var(--font-chrome); font-size: 12px; padding: 7px 12px; border: 1px solid var(--fg); background: var(--card); color: var(--fg); border-radius: var(--r-pill); cursor: pointer; text-decoration: none; transition: background .15s, color .15s; line-height: 1; white-space: nowrap; }
      button:hover, a.btn:hover { background: var(--fg); color: var(--bg); }
      button:disabled { opacity: .35; cursor: not-allowed; border-style: dashed; }
      button:disabled:hover { background: var(--card); color: var(--fg); }
      button.is-busy { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
      button.is-done { background: var(--fg); color: var(--pop); }
      /* Botón que se queda pulsado, como «Plegar todas». */
      button.on { background: var(--fg); border-color: var(--fg); color: var(--pop); }
      button.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 500; }
      button.primary:hover { background: var(--fg); color: var(--pop); border-color: var(--fg); }

      .note { font-family: var(--font-chrome); font-size: 11px; color: var(--muted); margin: 10px 0 0; line-height: 1.5; }
      .help { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-box); padding: 16px 18px; margin: 22px 0 4px; }
      .help h3 { font-family: var(--font-voz); margin: 0 0 8px; font-size: 15px; }
      .help p { margin: 0 0 6px; font-size: 13px; line-height: 1.55; color: var(--fg-soft); }
      .help code { font-family: var(--font-chrome); font-size: 12px; background: var(--chip-soft); padding: 1px 5px; border-radius: var(--r-sm); }

      /* ── Modal del adaptador ─────────────────────────────────────────── */
      #modal { position: fixed; inset: 0; z-index: 140; background: var(--scrim); display: none; }
      #modal.open { display: block; }
      .modal-panel { position: absolute; inset: 3vh 3vw; background: var(--bg); border-radius: var(--r-box); display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.4); }
      .modal-head { padding: 16px 22px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
      .modal-head h3 { font-family: var(--font-voz); margin: 0; font-size: 17px; flex: 1 1 260px; line-height: 1.25; }
      .modal-body { display: grid; grid-template-columns: 1fr 380px; gap: 0; overflow: hidden; }
      .slides-col { overflow-y: auto; padding: 18px 22px; }
      .preview-col { border-left: 1px solid var(--line); background: var(--stage); padding: 18px; overflow-y: auto; display: flex; flex-direction: column; align-items: center; gap: 12px; }
      .preview-col canvas { width: 100%; max-width: 320px; height: auto; border-radius: var(--r-sm); box-shadow: 0 4px 14px rgba(0,0,0,.18); display: block; }
      .preview-hint { font-family: var(--font-chrome); font-size: 11px; color: var(--muted); text-align: center; line-height: 1.5; margin: 0; }
      .style-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; width: 100%; max-width: 320px; }
      .style-options button {
        padding: 5px; border-radius: var(--r-sm); border: 1px solid var(--line); background: var(--card);
        display: flex; flex-direction: column; gap: 5px; align-items: center; white-space: normal;
      }
      .style-options button.on { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
      .style-options button:hover { background: var(--card); color: var(--fg); }
      .style-options canvas { width: 100%; height: auto; border-radius: 0; display: block; box-shadow: none; }
      .style-options span { font-family: var(--font-chrome); font-size: 10px; color: var(--muted); }
      .photo-tools { width: 100%; max-width: 320px; display: flex; flex-direction: column; gap: 8px; padding-top: 6px; border-top: 1px solid var(--line); }
      .photo-tools.is-off { opacity: .4; pointer-events: none; }
      .photo-row { display: flex; gap: 6px; }
      .photo-row button { flex: 1; }
      .slider { display: flex; align-items: center; gap: 8px; font-family: var(--font-chrome); font-size: 10px; color: var(--muted); }
      .slider span { flex: 0 0 74px; }
      .slider input[type='range'] { flex: 1; accent-color: var(--accent); }

      .slide-item { border: 1px solid var(--line); border-radius: var(--r-box); padding: 12px 14px; margin-bottom: 10px; background: var(--card); cursor: pointer; }
      .slide-item.sel { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
      .slide-top { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
      .slide-n { font-family: var(--font-chrome); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .slide-type { font-family: var(--font-chrome); font-size: 10px; padding: 2px 7px; border-radius: var(--r-pill); background: var(--chip); color: var(--muted); }
      .slide-tools { margin-left: auto; display: flex; gap: 4px; }
      .slide-tools button { padding: 4px 8px; font-size: 11px; }
      .slide-item input, .slide-item textarea { width: 100%; font-family: var(--font-display); border: 1px solid var(--line); border-radius: var(--r-sm); padding: 7px 9px; margin-bottom: 6px; resize: vertical; background: var(--bg); color: var(--fg); }
      .slide-item input { font-weight: 600; font-size: 14px; }
      .slide-item textarea { font-size: 13px; line-height: 1.45; min-height: 62px; }
      .chars { font-family: var(--font-chrome); font-size: 10px; color: var(--muted); text-align: right; }
      .chars.over { color: #e2574c; }

      .modal-foot { padding: 14px 22px; border-top: 1px solid var(--line); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
      .modal-foot .spacer { flex: 1; }
      .seg { display: inline-flex; align-items: stretch; border: 1px solid var(--fg); border-radius: var(--r-pill); overflow: hidden; }
      .seg button { border: 0; border-radius: 0; padding: 7px 14px; }
      .seg button.on { background: var(--fg); color: var(--pop); }
      /* Dos filtros seguidos con un botón «Todas» cada uno no se distinguen:
         cada grupo lleva su nombre dentro, como parte del control. */
      .seg-label { display: flex; align-items: center; padding: 0 11px; background: var(--chip); border-right: 1px solid var(--line); font-family: var(--font-chrome); font-weight: var(--w-label); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }

      /* ── Editor de textos por red ─────────────────────────────────────── */
      #tmodal { position: fixed; inset: 0; z-index: 150; background: var(--scrim); display: none; }
      #tmodal.open { display: block; }
      .t-panel { position: absolute; inset: 4vh 4vw; background: var(--bg); border-radius: var(--r-box); display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.4); }
      .t-head { padding: 16px 22px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
      .t-head h3 { font-family: var(--font-voz); margin: 0; font-size: 17px; flex: 1 1 240px; line-height: 1.25; }
      .t-thumb { width: 58px; height: 44px; flex: 0 0 auto; background: var(--chip); border-radius: var(--r-sm); overflow: hidden; display: block; }
      .t-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .t-thumb img[hidden] { display: none; }
      .t-logo { height: 26px; width: auto; max-width: 130px; object-fit: contain; object-position: right center; display: block; }
      /* Editor de textos. Todo lo que no es el campo (nombre, pista, cuenta y
         botones) se va a una columna estrecha a la izquierda: así el texto
         ocupa el resto y crece hasta caber entero, sin scroll dentro. */
      .t-body { overflow-y: auto; padding: 12px 18px; display: grid; gap: 6px; }
      .t-red {
        border: 1px solid var(--line); border-radius: var(--r-box); background: var(--card);
        padding: 10px 12px;
        display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 12px; align-items: start;
      }
      .t-lado { display: flex; flex-direction: column; gap: 5px; align-items: stretch; }
      .t-lado strong { font-family: var(--font-voz); font-size: 15px; line-height: 1.15; }
      .t-lado .pista { font-family: var(--font-chrome); font-size: 10px; line-height: 1.4; color: var(--muted); }
      .t-lado button { width: 100%; }
      .t-red textarea {
        width: 100%; font-family: var(--font-display); font-size: 14px; line-height: 1.55;
        padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--r-sm);
        background: var(--bg); color: var(--fg);
        /* La altura la pone el JavaScript según lo que haya escrito: ni barra
           propia ni tirador, porque siempre cabe entero. */
        resize: none; overflow: hidden; min-height: 0; display: block;
      }
      .t-cuenta { font-family: var(--font-dato); font-size: 11px; color: var(--muted); }
      .t-cuenta.pasa { color: #e2574c; font-weight: 600; }
      .t-editado { font-family: var(--font-chrome); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
      .t-foot { padding: 14px 22px; border-top: 1px solid var(--line); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
      .t-foot .spacer { flex: 1; }

      @media (max-width: 720px) {
        .t-panel { inset: 0; border-radius: 0; }
        /* Sin sitio para dos columnas: la chapa vuelve encima del campo, en
           fila, para que el texto siga ocupando todo el ancho. */
        .t-red { grid-template-columns: 1fr; gap: 8px; }
        .t-lado { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 8px; }
        .t-lado .pista { flex: 1 1 100%; }
        .t-lado button { width: auto; }
        .t-logo { display: none; }
      }

      #toast { position: fixed; left: 50%; bottom: 26px; transform: translate(-50%, 20px); background: var(--fg); color: var(--bg); font-family: var(--font-chrome); font-size: 13px; padding: 11px 18px; border-radius: var(--r-pill); opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; z-index: 200; max-width: 90vw; text-align: center; }
      #toast.show { opacity: 1; transform: translate(-50%, 0); }

      @media (max-width: 900px) {
        .modal-body { grid-template-columns: 1fr; }
        .preview-col { border-left: 0; border-top: 1px solid var(--line); }
      }
      @media (max-width: 900px) {
        .card { grid-template-columns: 1fr; }
        /* En una columna, el título tiene que ir antes que nada: si no, la
           foto y la revisión aparecen sin saber todavía de qué pieza son. */
        .card-side { order: 2; }
        .card-body { order: 1; }
        .thumb { max-width: 260px; }
        .modal-panel { inset: 0; border-radius: 0; }
        /* La tabla de cinco columnas no cabe: cada red pasa a ser un bloque
           con su nombre arriba y la casilla a la derecha del todo. */
        .redes { display: block; }
        .red-cab { display: none; }
        .red-fila { display: grid; grid-template-columns: 1fr 28px; gap: 4px 10px; padding: 10px 0; border-bottom: 1px solid var(--line-soft, rgba(128,128,128,.16)); }
        .red-fila > span { border-bottom: 0; padding: 0; min-height: 0; }
        .red-n { grid-column: 1; font-size: 13px; }
        .red-ok { grid-column: 2; grid-row: 1 / span 4; align-items: start !important; }
        .red-img, .red-txt, .red-ir { grid-column: 1; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      {/* Cabecera del panel: fija arriba, con el logotipo de la marca a la
          derecha. Es lo único que distingue un kit del otro de un vistazo,
          así que no se va con el scroll. */}
      <header class="pnl">
        <div class="pnl-top">
          <span class="pnl-titulo">Kit de redes</span>
          <nav class="kit-switch" aria-label="Elegir kit">
            {KITS.map((k) => (
              <a href={k.href} class={k.id === brand.id ? 'on' : ''} aria-current={k.id === brand.id ? 'page' : undefined}>
                {k.label}
              </a>
            ))}
          </nav>
          <a class="pnl-link" href="/calendario/">Calendario</a>
          {brand.cmsEditHref && <a class="pnl-link" href="/admin/" target="_blank" rel="noopener">Editor</a>}
          <img class="pnl-logo" src={brand.logo} alt={brand.org} width="120" height="40" />
        </div>

        <div class="toolbar">
          <input type="search" id="q" placeholder="Buscar…" aria-label="Buscar" />
          <label><input type="checkbox" id="overlay" checked /> Portada con título y marca</label>
          <span class="seg" id="styleSeg" title="Diseño de las imágenes con texto">
            <button data-style="cinta" class="on">Cinta</button>
            <button data-style="bloque">Bloque</button>
            <button data-style="marco">Marco</button>
          </span>
          <label><input type="checkbox" id="onlyPub" /> Solo en la web</label>
          <span class="seg" id="revSeg">
            <span class="seg-label">Revisión</span>
            <button data-rev="all" class="on">Todas</button>
            <button data-rev="sin">Sin revisar (<span data-rv-count="sin">{sinRevisar}</span>)</button>
            <button data-rev="listo">Listos (<span data-rv-count="listo">{marcadas.listo}</span>)</button>
            <button data-rev="cambios">Con notas (<span data-rv-count="cambios">{marcadas.cambios}</span>)</button>
          </span>
          <span class="seg" id="pubSeg">
            <span class="seg-label">En redes</span>
            <button data-pub="all" class="on">Todas</button>
            <button data-pub="no">Sin subir (<span data-rv-count="pubno">{posts.length}</span>)</button>
            <button data-pub="parte">A medias (<span data-rv-count="pubparte">0</span>)</button>
            <button data-pub="todo">Subidas (<span data-rv-count="pubtodo">0</span>)</button>
          </span>
          <span class="seg" id="tipoSeg">
            <span class="seg-label">Tipo</span>
            <button data-tipo="all" class="on">Todas</button>
            <button data-tipo="post">Post ({posts.filter((p) => p.kind !== 'social').length})</button>
            <button data-tipo="social">Solo redes ({posts.filter((p) => p.kind === 'social').length})</button>
          </span>
          <button id="plegarTodo" aria-pressed="false" title="Ver solo el título y los datos de cada pieza">Plegar todas</button>
          <button id="ordenFecha" title="Deshacer el orden a mano y volver al orden por fecha" hidden>Orden por fecha</button>
          <span class="count" id="count">{published} en la web · {posts.length} en total</span>
        </div>
      </header>

      {posts.map((p, i) => {
        // Las diapositivas son portada + contenido + cierre. Sin ninguna de
        // contenido no hay carrusel que montar, solo una imagen que bajar.
        const hayCarrusel = p.slides.length >= 3;
        return (
        <article
          class="card"
          data-title={p.title.toLowerCase()}
          data-status={p.status}
          data-kind={p.kind === 'social' ? 'social' : 'post'}
          data-i={i}
          data-nat={i}
          data-rv-item
          data-rv-key={`${p.lang}/${p.slug}`}
          data-rv-title={p.title}
        >
          {/* Columna izquierda: la foto y la revisión, que es lo que se
              decide una vez por pieza. */}
          <div class="card-side">
            <span class={`thumb${p.image ? '' : ' no-img'}`}>
              {p.image && <img src={p.image} alt="" loading="lazy" crossorigin="anonymous" />}
            </span>
            <RevisionItem
              nota={revisiones[`${p.lang}/${p.slug}`]?.nota || ''}
              fecha={revisiones[`${p.lang}/${p.slug}`]?.fecha_prevista || ''}
              label="Revisión"
              class="rv-col"
            />
          </div>

          <div class="card-body">
            <h2>
              {/* Asa de arrastre: la ficha entera no puede serlo, está llena de
                  botones y campos que hay que poder seleccionar. */}
              <span class="card-grip" data-grip role="button" tabindex="0" title="Arrastra para mover esta pieza" aria-label="Mover esta pieza">⠿</span>
              <span>{p.title}</span>
              {/* Plegar la ficha: con treinta y dos, verlas todas de un
                  vistazo vale más que tener los botones a mano. Va a la
                  derecha, en la misma columna en todas las filas, para poder
                  bajar plegando sin perseguir el final de cada título. */}
              <button class="card-fold" data-fold aria-expanded="true" title="Plegar o desplegar esta ficha">▾</button>
            </h2>
            <p class="meta">
              {/* Qué es: una pieza con artículo detrás o algo que solo va a
                  redes. Cambia lo que hay que hacer con ella, así que va
                  delante del todo. */}
              <span class={`badge tipo ${p.kind === 'social' ? 'social' : 'post'}`}>
                {p.kind === 'social' ? 'Solo redes' : 'Post'}
              </span>
              <span class={`badge ${p.status === 'publish' ? 'pub' : 'draft'}`}>
                {p.status === 'publish' ? brand.statusLabels.publish : brand.statusLabels.draft}
              </span>
              <span>{p.date}</span>
              <span>{p.lang.toUpperCase()}</span>
              <span>{p.slides.length} diapositivas sugeridas</span>
              <span class="rv-pill" data-rv-pill hidden></span>
            </p>

            {/* Una fila por red, en el orden en que se publica: la imagen, el
                texto, el atajo para subirlo y la casilla de hecho. Así se va
                de una en una sin saltar de un bloque a otro. */}
            <div class="redes">
              <div class="red-cab">
                <span>Red</span><span>Imagen · ✎ editar · ↓ descargar</span><span>Texto</span><span>Subir</span><span>Hecho</span>
              </div>

              <div class="red-fila">
                <span class="red-n">{p.kind === 'social' ? 'Página' : 'Post en la web'}</span>
                <span class="red-img"><em class="red-na">{p.kind === 'social' ? 'no hay artículo que publicar' : 'la foto de arriba'}</em></span>
                <span class="red-txt"><button data-textos>Ver y editar textos</button></span>
                <span class="red-ir">
                  {p.status === 'publish' && <a class="red-a" href={p.url} target="_blank" rel="noopener">Ver ↗</a>}
                  {brand.cmsEditHref && (
                    <a
                      class="red-a"
                      href={brand.cmsEditHref.replace('{lang}', p.lang).replace('{slug}', p.slug)}
                      target="_blank"
                      rel="noopener"
                    >{p.status === 'publish' ? 'Editar ↗' : 'Publicar ↗'}</a>
                  )}
                </span>
                <span class="red-ok">
                  <span class="red-corto">{p.kind === 'social' ? 'Pág' : 'Post'}</span>
                  <input
                    type="checkbox"
                    disabled
                    checked={p.status === 'publish'}
                    data-rv-pub-auto="post"
                    title={p.status === 'publish'
                      ? 'Ya está en la web. Se marca solo.'
                      : 'Todavía es borrador. Publícalo en el editor y aquí se marca solo.'}
                  />
                </span>
              </div>

              {FILAS.map((f) => (
                <div class="red-fila">
                  <span class="red-n">{f.nombre}</span>
                  <span class="red-img">
                    {f.imgs
                      .filter((b) => !b.adapt || hayCarrusel)
                      .map((b) =>
                        b.adapt ? (
                          <button
                            class="es-montar"
                            data-adapt={b.adapt}
                            disabled={!p.image}
                            title={`Abre el editor con ${p.slides.length} diapositivas: cámbialas y descárgalas en orden`}
                          >{b.label} ✎</button>
                        ) : (
                          <button
                            data-dl={b.dl}
                            disabled={!p.image}
                            title="Descarga la imagen tal cual, sin pasar por el editor"
                          >{b.label} ↓</button>
                        )
                      )}
                    {!hayCarrusel && f.imgs.some((b) => b.adapt) && (
                      <em class="red-na">una sola imagen, no hay carrusel que montar</em>
                    )}
                  </span>
                  <span class="red-txt"><button data-copy={f.id}>Copiar</button></span>
                  <span class="red-ir">
                    {f.href && (
                      <button
                        class="red-a"
                        data-rv-ir={f.id}
                        data-rv-ir-href={f.href}
                        title={`Copia el texto de ${f.nombre} y abre la página para publicar`}
                      >Abrir ↗</button>
                    )}
                  </span>
                  <span class="red-ok">
                    <span class="red-corto">{f.corto}</span>
                    <input type="checkbox" data-rv-pub={f.id} title={f.nombre} />
                  </span>
                  {/* Enlace de la publicación, para poder volver a ella al
                      revisar. Solo aparece cuando la red está marcada: antes
                      de subirla no hay nada que pegar. */}
                  <span class="red-url">
                    <input
                      type="url"
                      data-rv-url={f.id}
                      placeholder={`Pega aquí el enlace de la publicación en ${f.nombre}`}
                      spellcheck="false"
                    />
                    <a class="red-url-ir" data-rv-url-ir={f.id} target="_blank" rel="noopener" hidden>Ver ↗</a>
                  </span>
                </div>
              ))}

              <div class="red-extra">
                <button data-dl="orig" disabled={!p.image}>Foto original</button>
                <button data-copy="url">Copiar enlace</button>
                <button data-dl="txt">Descargar .txt</button>
                <span class="rv-pub-aviso" data-rv-pub-aviso hidden></span>
              </div>
            </div>

            {p.status !== 'publish' && <p class="note">{brand.draftNote}</p>}
          </div>
        </article>
        );
      })}

      <div class="help">
        <h3>Cómo se sube a Instagram</h3>
        <p>
          Instagram no permite publicar desde una web, así que el último paso siempre es manual:
          pulsa <code>Adaptar a Instagram</code>, ajusta los textos, y descarga las imágenes
          (se numeran <code>01</code>, <code>02</code>… para que las subas en orden).
          Copia el pie de foto y pégalo al publicar.
        </p>
        <p>
          Si lo haces desde el móvil, las imágenes van directas a tu galería y puedes
          seleccionarlas todas de golpe al crear el carrusel.
        </p>
        <p>
          Los archivos se descargan con el prefijo <code>{brand.id}-</code>, para que no se
          mezclen con los del otro kit.
        </p>
      </div>
    </div>

    <div id="modal" role="dialog" aria-modal="true" aria-label="Adaptar a Instagram">
      <div class="modal-panel">
        <div class="modal-head">
          <h3 id="m-title">Adaptar</h3>
          <div class="seg" id="m-format">
            <button data-fmt="ig" class="on">Carrusel 1:1</button>
            <button data-fmt="story">Story · TikTok 9:16</button>
          </div>
          <button id="m-close">Cerrar</button>
        </div>
        <div class="modal-body">
          <div class="slides-col" id="m-slides"></div>
          <div class="preview-col">
            <canvas id="m-canvas" width="1080" height="1080"></canvas>
            <p class="preview-hint" id="m-hint">Vista previa</p>
            <p class="preview-hint"><strong>Elige diseño</strong></p>
            <div class="style-options" id="m-styles">
              <button type="button" data-style="cinta" class="on">
                <canvas width="540" height="540"></canvas><span>Cinta</span>
              </button>
              <button type="button" data-style="bloque">
                <canvas width="540" height="540"></canvas><span>Bloque</span>
              </button>
              <button type="button" data-style="marco">
                <canvas width="540" height="540"></canvas><span>Marco</span>
              </button>
            </div>
            <div class="photo-tools" id="m-photo">
              <p class="preview-hint"><strong>Foto de la portada</strong></p>
              <div class="photo-row">
                <button type="button" id="m-photo-pick">Cambiar foto…</button>
                <button type="button" id="m-photo-reset">Original</button>
              </div>
              <input type="file" id="m-photo-file" accept="image/*" hidden />
              <label class="slider">
                <span>Encuadre ↔</span>
                <input type="range" id="m-fx" min="0" max="100" value="50" />
              </label>
              <label class="slider">
                <span>Encuadre ↕</span>
                <input type="range" id="m-fy" min="0" max="100" value="50" />
              </label>
              <p class="preview-hint" id="m-photo-hint">Arrastra para mover el centro de la foto.</p>
            </div>
            <button id="m-dl-one">Descargar solo esta</button>
          </div>
        </div>
        <div class="modal-foot">
          <button id="m-add">+ Diapositiva</button>
          <button id="m-add-quote">+ Cita</button>
          <button id="m-reset">Reiniciar textos</button>
          <span class="spacer"></span>
          <button id="m-copy">Copiar pie de foto</button>
          <button class="primary" id="m-dl-all">Descargar todas</button>
        </div>
      </div>
    </div>

    <div id="tmodal" role="dialog" aria-modal="true" aria-label="Textos para redes">
      <div class="t-panel">
        {/* La cabecera no se va con el scroll: la foto y el logotipo dicen en
            todo momento de qué pieza y de qué marca son estos textos. */}
        <div class="t-head">
          <span class="t-thumb"><img id="t-img" alt="" crossorigin="anonymous" hidden /></span>
          <h3 id="t-title">Textos</h3>
          <button id="t-close">Cerrar</button>
          <img class="t-logo" src={brand.logo} alt={brand.org} width="120" height="34" />
        </div>
        <div class="t-body" id="t-body"></div>
        <div class="t-foot">
          <button id="t-reset">Volver a los automáticos</button>
          <span class="spacer"></span>
          <span class="t-editado" id="t-estado"></span>
        </div>
      </div>
    </div>

    <div id="toast" role="status" aria-live="polite"></div>

    <RevisionBar
      path={brand.reviewPath}
      lsKey={brand.reviewLS}
      guardadas={revisiones}
      unidad={brand.unit.one}
    />

    <script type="application/json" id="kit-data" set:html={dataJson}></script>
    <script type="application/json" id="kit-brand" set:html={brandJson}></script>

    <script is:inline>
      (function () {
        var POSTS = JSON.parse(document.getElementById('kit-data').textContent);
        var B = JSON.parse(document.getElementById('kit-brand').textContent);
        var SIZES = { ig: [1080, 1080, 'instagram'], story: [1080, 1920, 'story'], fb: [1200, 630, 'facebook-linkedin'], x: [1600, 900, 'x'] };

        // Los velos y degradados se derivan de la paleta de la marca, para que
        // una marca nueva no obligue a tocar el motor.
        function rgba(hex, a) {
          var h = String(hex).replace('#', '');
          if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
          var n = parseInt(h, 16);
          return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + a + ')';
        }

        var toastEl = document.getElementById('toast'), toastTimer;
        function toast(m) {
          toastEl.textContent = m; toastEl.classList.add('show');
          clearTimeout(toastTimer); toastTimer = setTimeout(function () { toastEl.classList.remove('show'); }, 2800);
        }
        function slugify(s) {
          return (s || B.id).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
            .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);
        }
        // Prefijo de marca: así los archivos de los dos kits nunca se mezclan
        // en la carpeta de descargas.
        function fileName(slug, parts) {
          return B.id + '-' + slugify(slug) + '-' + parts.join('-');
        }
        function hashtags(tags, max) {
          var extra = (tags || []).filter(Boolean).map(function (t) {
            return t.trim().replace(/\s+/g, '').replace(/[^\p{L}\p{N}]/gu, '');
          }).filter(function (t) { return t.length > 2; });
          var all = B.baseTags.concat(extra), seen = {}, out = [];
          for (var i = 0; i < all.length && out.length < max; i++) {
            var k = all[i].toLowerCase();
            if (!seen[k]) { seen[k] = 1; out.push('#' + all[i]); }
          }
          return out.join(' ');
        }
        function captions(d) {
          return {
            ig: d.title + '\n\n' + d.excerpt + '\n\n' + B.captionTail + '\n\n' + hashtags(d.tags, 12),
            fb: d.title + '\n\n' + d.excerpt + '\n\n' + d.url,
            li: d.title + '\n\n' + d.excerpt + '\n\n' + B.captionLead + d.url + '\n\n' + hashtags(d.tags, 5),
            x: (d.title.length > 90 ? d.title.slice(0, 87) + '…' : d.title) + '\n\n' + d.url,
            // TikTok no hace pulsable ningún enlace del pie: pegar la URL solo
            // gastaría caracteres, así que se manda a la bio como en Instagram.
            // Y como apenas se lee la primera línea, el titular va solo delante.
            tt: d.title + '\n\n' + d.excerpt + '\n\n' + B.captionTail + '\n\n' + hashtags(d.tags, 6),
            url: d.url,
          };
        }
        // Redes que se pueden editar, con el límite que impone cada una.
        var REDES = [
          { id: 'ig', nombre: 'Instagram', limite: 2200, pista: 'Pie de foto. Los hashtags cuentan.' },
          { id: 'fb', nombre: 'Facebook', limite: 63206, pista: 'Sin límite en la práctica; las primeras líneas son las que se leen.' },
          { id: 'li', nombre: 'LinkedIn', limite: 3000, pista: 'Se corta en «ver más» a las 3 líneas.' },
          { id: 'x', nombre: 'X', limite: 280, pista: 'El enlace también ocupa.' },
          { id: 'tt', nombre: 'TikTok', limite: 4000, pista: 'El enlace no se puede pulsar: va en la bio. Solo se lee la primera línea.' },
        ];

        function claveDe(d) { return d.lang + '/' + d.slug; }

        /** Lo guardado a mano para esa red, o el automático si no se ha tocado. */
        function textoDe(d, red) {
          var guardado = (window.ADAR_REV ? (ADAR_REV.obtener(claveDe(d)).textos || {}) : {})[red];
          if (typeof guardado === 'string' && guardado.trim()) return guardado;
          return captions(d)[red];
        }

        function wrapText(ctx, text, maxW) {
          var words = String(text).split(/\s+/), lines = [], line = '';
          for (var i = 0; i < words.length; i++) {
            var test = line ? line + ' ' + words[i] : words[i];
            if (ctx.measureText(test).width > maxW && line) { lines.push(line); line = words[i]; }
            else line = test;
          }
          if (line) lines.push(line);
          return lines;
        }
        // Reduce el cuerpo hasta que quepa en la caja disponible.
        function fitLines(ctx, text, maxW, maxH, weight, family, start, min) {
          var size = start;
          while (size > min) {
            ctx.font = weight + ' ' + size + 'px ' + family;
            var ls = wrapText(ctx, text, maxW);
            if (ls.length * size * 1.32 <= maxH) return { size: size, lines: ls };
            size -= 2;
          }
          ctx.font = weight + ' ' + min + 'px ' + family;
          return { size: min, lines: wrapText(ctx, text, maxW) };
        }
        function loadImage(src) {
          return new Promise(function (res, rej) {
            var img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function () { res(img); };
            img.onerror = function () { rej(new Error('no se pudo cargar la imagen')); };
            img.src = src;
