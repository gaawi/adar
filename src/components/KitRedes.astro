          var tf = fitLines(ctx, slide.title, maxW, areaH * 0.34, TW, DISPLAY, Math.round(W * 0.066), Math.round(W * 0.036));
          var tTitleH = tf.lines.length * tf.size * 1.12;
          var bf2 = fitLines(ctx, slide.body, maxW, areaH - tTitleH - ruleH - gapRule - gapBody, '400', UI, Math.round(W * 0.042), Math.round(W * 0.024));
          var tBodyH = bf2.lines.length * bf2.size * 1.42;
          var tTotal = ruleH + gapRule + tTitleH + gapBody + tBodyH;
          var tTop = areaTop + Math.max(0, (areaH - tTotal) / 2);

          ctx.fillStyle = B.accent;
