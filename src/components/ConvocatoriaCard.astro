---
// Una convocatoria, en tarjeta. Se usa en /participa/ y en el carril lateral
// de la página de residencias, así que el estilo vive aquí y no en cada página.
import type { Lang } from '../i18n/strings.ts';
import { ETIQUETA, diasRestantes, ediciones, type Convocatoria } from '../data/convocatorias.ts';
import IconoFamilia from './IconoFamilia.astro';

interface Props {
  c: Convocatoria;
  lang: Lang;
  /** `compacta` quita el «para quién» y el resumen: para el carril lateral. */
  compacta?: boolean;
}

const { c, lang, compacta = false } = Astro.props;

const href = c.href?.[lang];
const dias = diasRestantes(c);
const cta = c.cta?.[lang] ?? { es: 'Más información', en: 'More information', ast: 'Más información' }[lang];
const restan = dias !== null && dias >= 0
  ? { es: `Quedan ${dias} días`, en: `${dias} days left`, ast: `Queden ${dias} díes` }[lang]
  : null;

// El histórico cuelga de la propia convocatoria: lo que se convocó antes
// bajo este mismo nombre. En el carril lateral no cabe, así que se omite.
const pasadas = compacta ? [] : ediciones(c.id);
const EDICIONES_H = {
  es: 'Ediciones anteriores',
  en: 'Previous editions',
  ast: 'Ediciones anteriores',
}[lang];
---

<article class={`cv-card cv-${c.estado}${compacta ? ' cv-compacta' : ''}`}>
  <p class="cv-chip">
    <IconoFamilia familia={c.familia} size={15} />
    <span>{ETIQUETA[c.estado][lang]}</span>
  </p>
  <h3 class="cv-title">
    {href ? <a href={href}>{c.titulo[lang]}</a> : c.titulo[lang]}
  </h3>
  {!compacta && <p class="cv-quien">{c.paraQuien[lang]}</p>}
  {!compacta && <p class="cv-que">{c.que[lang]}</p>}
  <p class="cv-cuando">
    {c.cuando[lang]}
    {restan && <b class="cv-restan">{restan}</b>}
  </p>
  {href && <p class="cv-cta"><a href={href}>{cta} <span aria-hidden="true">→</span></a></p>}

  {pasadas.length > 0 && (
    <div class="cv-ed">
      <p class="cv-ed-h">{EDICIONES_H}</p>
      <ul>
        {pasadas.map((e) => {
          const eh = e.href?.[lang];
          const rotulo = e.edicion?.[lang] ?? e.titulo[lang];
          return <li>{eh ? <a href={eh}>{rotulo}</a> : rotulo}</li>;
        })}
      </ul>
    </div>
  )}
</article>

<style is:global>
  /* Selectores largos: el tema heredado tiene reglas sueltas para h3, p y a
     dentro de .entry-content que ganan si se escribe corto. */
  body .entry-content .cv-card {
    border: 1px solid var(--line, rgba(10, 9, 7, 0.16));
    border-left: 3px solid var(--line, rgba(10, 9, 7, 0.16));
    padding: 20px 22px 22px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }
  body .entry-content .cv-card.cv-permanente,
  body .entry-content .cv-card.cv-abierta { border-left-color: #1d6b3f; }
  body .entry-content .cv-card.cv-proxima { border-left-color: #9a5b12; }
  body .entry-content .cv-card.cv-cerrada { border-left-color: rgba(10, 9, 7, 0.22); background: transparent; }

  body .entry-content .cv-card .cv-chip {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 9px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  body .entry-content .cv-card.cv-permanente .cv-chip,
  body .entry-content .cv-card.cv-abierta .cv-chip { color: #1d6b3f; }
  body .entry-content .cv-card.cv-proxima .cv-chip { color: #9a5b12; }

  body .entry-content .cv-card .cv-title {
    font-family: var(--font-voz);
    font-weight: var(--peso-titulo, 700);
    font-size: 21px;
    line-height: 1.2;
    margin: 0 0 10px;
    color: var(--ink, #0a0907);
  }
  body .entry-content .cv-card .cv-title a {
    color: inherit;
    text-decoration: none;
    border: 0;
  }
  body .entry-content .cv-card .cv-title a:hover { text-decoration: underline; }

  body .entry-content .cv-card .cv-quien {
    font-size: 13px;
    line-height: 1.4;
    color: var(--muted);
    margin: 0 0 10px;
  }
  body .entry-content .cv-card .cv-que {
    font-size: 14.5px;
    line-height: 1.55;
    margin: 0 0 14px;
  }
  body .entry-content .cv-card .cv-cuando {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.45;
    margin: 0;
    color: var(--ink, #0a0907);
  }
  body .entry-content .cv-card .cv-restan {
    display: block;
    color: #a32015;
    margin-top: 3px;
  }
  body .entry-content .cv-card .cv-cta {
    margin: 14px 0 0;
    font-size: 14px;
  }
  body .entry-content .cv-card .cv-cta a {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  /* El histórico de la convocatoria, dentro de su propia tarjeta. */
  body .entry-content .cv-card .cv-ed {
    margin: 16px 0 0;
    padding: 13px 0 0;
    border-top: 1px solid var(--line, rgba(10, 9, 7, 0.14));
  }
  body .entry-content .cv-card .cv-ed-h {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 7px;
  }
  body .entry-content .cv-card .cv-ed ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  body .entry-content .cv-card .cv-ed li {
    margin: 0 0 4px;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    line-height: 1.4;
  }
  body .entry-content .cv-card .cv-ed li::before,
  body .entry-content .cv-card .cv-ed li::marker { content: none; }
  body .entry-content .cv-card .cv-ed li:last-child { margin-bottom: 0; }
  body .entry-content .cv-card .cv-ed a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid rgba(10, 9, 7, 0.25);
  }
  body .entry-content .cv-card .cv-ed a:hover { color: var(--ink, #0a0907); }

  /* Variante estrecha del carril lateral. */
  body .entry-content .cv-card.cv-compacta { padding: 15px 16px 16px; }
  body .entry-content .cv-card.cv-compacta .cv-title { font-size: 17px; margin-bottom: 7px; }
  body .entry-content .cv-card.cv-compacta .cv-cta { margin-top: 10px; font-size: 13px; }

  /* Rejilla reutilizable para los grupos de tarjetas. */
  body .entry-content .cv-grid {
    display: grid;
    /* auto-fill y no auto-fit: con una sola tarjeta, auto-fit la estiraba a
       los 1200px del contenido y quedaba ridícula. */
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 700px) {
    body .entry-content .cv-grid { grid-template-columns: 1fr; gap: 14px; }
    body .entry-content .cv-card { padding: 17px 18px 19px; }
  }
</style>
