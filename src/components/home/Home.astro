<script is:inline>
  /* Mark concerts that have already taken place so the list visibly
     advances as the festival unfolds (kept visible, just struck through).
     Runs on the client, so it updates day to day without a rebuild. */
  (function () {
    var now = Date.now();
    document.querySelectorAll('.hm-adar26-row[data-start]').forEach(function (li) {
      if (li.classList.contains('is-cancelled') || li.classList.contains('is-postponed')) return;
      var t = Date.parse(li.getAttribute('data-start'));
      if (!isNaN(t) && now >= t) li.classList.add('is-past');
    });

    /* "HOY": destaca el concierto de hoy (día de Asturias) arriba del todo
       en móvil, enlazando a su programa completo. Sin datos duplicados: lo
       rellena desde la fila del listado cuya fecha es hoy. */
    var card = document.getElementById('hm-today');
    if (card) {
      var todayES = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Madrid' });
      var todayRow = null;
      document.querySelectorAll('.hm-adar26-row[data-start]').forEach(function (li) {
        var lastDay = (li.getAttribute('data-start') || '').slice(0, 10);
        var firstDay = li.getAttribute('data-firstday') || lastDay;
        if (todayES >= firstDay && todayES <= lastDay) todayRow = li;
      });
      /* Se muestra la tarjeta si hoy hay evento, incluso pospuesto
         (así quien esperaba la actividad de hoy ve el aviso). Sólo los
         cancelados se omiten. */
      if (todayRow && !todayRow.classList.contains('is-cancelled')) {
        var isPostponed = todayRow.classList.contains('is-postponed');
        var q = function (sel) { var e = todayRow.querySelector(sel); return e ? e.textContent.trim() : ''; };
        var set = function (sel, val) { var e = card.querySelector(sel); if (e) e.textContent = val; };
        set('[data-today-when]', [q('.hm-adar26-dow'), q('.hm-adar26-date'), q('.hm-adar26-time')].filter(Boolean).join(' · '));
        set('[data-today-zone]', q('.hm-adar26-zone'));
        set('[data-today-title]', q('.hm-adar26-kind'));
        set('[data-today-venue]', q('.hm-adar26-venue'));
        var rowImg = todayRow.querySelector('.hm-adar26-thumb img');
        var cardImg = card.querySelector('[data-today-photo]');
        if (rowImg && cardImg && rowImg.getAttribute('src')) {
          cardImg.setAttribute('src', rowImg.getAttribute('src'));
          cardImg.setAttribute('alt', q('.hm-adar26-kind'));
        } else if (cardImg) {
          cardImg.parentNode.style.display = 'none';
        }
        if (isPostponed) {
          card.classList.add('is-postponed');
          set('[data-today-tag]', card.getAttribute('data-postponed-label') || '');
          set('[data-today-intro-el]', card.getAttribute('data-postponed-intro') || '');
          var noteEl = card.querySelector('[data-today-note]');
          if (noteEl) { noteEl.textContent = card.getAttribute('data-postponed-note') || ''; noteEl.hidden = false; }
        }
        var link = todayRow.querySelector('.hm-adar26-link');
        if (link) card.setAttribute('href', link.getAttribute('href'));
        card.hidden = false;
        document.documentElement.classList.add('has-hm-today');
      }
    }
  })();
</script>
