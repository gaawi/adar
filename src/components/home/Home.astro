// ISO start datetime per concert so the client can mark past ones as
// "celebrado" (the list advances on its own each day, no rebuild needed).
// August in Asturias is CEST (UTC+2). For multi-day rows, use the last day.
function eventStartISO(dateStr: string, timeStr: string): string {
  const days = (dateStr.match(/\d+/g) || ['1']).map(Number);
  const day = String(days[days.length - 1]).padStart(2, '0');
  const tm = (timeStr.match(/\d{1,2}:\d{2}/) || ['20:30'])[0];
  return `2026-08-${day}T${tm}:00+02:00`;
}
// First day (yyyy-mm-dd) — para casar "hoy" en eventos de varios días.
function eventFirstDay(dateStr: string): string {
  const days = (dateStr.match(/\d+/g) || ['1']).map(Number);
  return `2026-08-${String(days[0]).padStart(2, '0')}`;
}
