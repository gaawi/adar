---
import type { Lang } from '../i18n/strings.ts';
import { HOME_SLUG } from '../i18n/strings.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  es: {
    desc: 'Festival ADAR es un proyecto de la Asociación para el Desarrollo de las Artes en el Medio Rural.',
    base: 'Sede: Leiguarda 47 · Belmonte de Miranda · Asturias · CIF G06781884',
    contact: 'Contacto',
    propose: 'Enviar una propuesta artística',
    propose_href: '/es/propuestas-artisticas/',
    funded: 'Financiado por',
    funded_note: 'Financiado por la Unión Europea e implementado por el Goethe-Institut.',
    funded_link: 'Qué financia la Unión Europea',
    funded_href: '/es/financiacion-europea/',
    funded_asturias: 'Actividad subvencionada por el Gobierno del Principado de Asturias.',
    partners: 'Red de colaboración',
    bill_copy: 'Copiar datos de facturación',
    bill_done: '¡Copiado!',
  },
  en: {
    desc: 'Festival ADAR is a project of the Association for the Development of Arts in the Rural Environment.',
    base: 'Headquarters: Leiguarda 47 · Belmonte de Miranda · Asturias · CIF G06781884',
    contact: 'Contact',
    propose: 'Submit an artistic proposal',
    propose_href: '/en/submit-a-proposal/',
    funded: 'Funded by',
    funded_note: 'Funded by the European Union and implemented by the Goethe-Institut.',
    funded_link: 'What the European Union funds',
    funded_href: '/en/european-funding/',
    funded_asturias: 'Actividad subvencionada por el Gobierno del Principado de Asturias.',
    partners: 'Network of partners',
    bill_copy: 'Copy billing details',
    bill_done: 'Copied!',
  },
  ast: {
    desc: "Festival ADAR ye un proxectu de l'Asociación pal Desarrollu de les Artes nel Mediu Rural.",
    base: 'Sede: Leiguarda 47 · Belmonte de Miranda · Asturies · CIF G06781884',
    contact: 'Contautu',
    propose: 'Unviar una propuesta artística',
    propose_href: '/ast/propuestes-artistiques/',
    funded: 'Financiao por',
    funded_note: 'Financiao pola Xunión Europea ya implementao pol Goethe-Institut.',
    funded_link: 'Qué financia la Xunión Europea',
    funded_href: '/ast/financiacion-europea/',
    funded_asturias: 'Actividad subvencionada por el Gobierno del Principado de Asturias.',
    partners: 'Rede de collaboración',
    bill_copy: 'Copiar datos de facturación',
    bill_done: '¡Copiao!',
  },
}[lang];

// Datos de facturación (razón social · CIF · domicilio fiscal · email).
// Se copian con los saltos de línea reconstruidos desde el separador '|'.
const BILLING = [
  'Asociación Para el Desarrollo de las Artes en el Medio Rural',
  'Lugar Leiguarda 47',
  '33845 Belmonte de Miranda',
  'CIF: G06781884',
].join('|');

const PARTNERS = [
  { name: 'CreArtBox', logo: '/logos/creartbox.jpg', href: 'https://creartbox.nyc/' },
  { name: 'Porto PianoFest', logo: '/logos/portopiano.jpg', href: 'https://www.portopianofest.com/' },
  { name: 'Opus 71 Concerts', logo: '/logos/opus71.jpg', href: 'https://www.opus71concerts.com/' },
  { name: 'Paris Chamber Music Circle', logo: '/logos/paris.jpg', href: '#' },
  { name: 'Asociación Musical Diego Silva Montero', logo: '/logos/diego-silva.jpg', href: '#' },
  { name: 'Ballarte Festival', logo: '/logos/ballarte.png', href: 'https://ballartefestival.benasque.com/' },
  { name: 'Paradores', logo: '/logos/paradores.jpg', href: 'https://paradores.es/' },
  { name: 'Escuela Reina Sofía', logo: '/logos/reina-sofia.jpg', href: 'https://www.escuelasuperiordemusicareinasofia.es/' },
];

// El emblema de la Unión Europea tiene reglas de uso: se reproduce en su
// color, sobre fondo claro y sin deformarlo. Antes eran dos logotipos
// sueltos pintados de blanco con un filtro, y la bandera salía como una
// mancha sin estrellas. Ahora va el bloque oficial «Funded by the European
// Union · Goethe-Institut» que manda Culture Moves Europe, tal cual, sobre
// una banda clara.
// `h` es el alto de cada marca. No vale uno común: el bloque del Ministerio
// lleva mucho aire dentro de su recuadro y, a la misma altura que el resto,
// «MINISTERIO DE CULTURA» no se lee. Las cifras están igualadas a ojo para
// que las cuatro pesen lo mismo, no para que midan lo mismo.
const FUNDERS = [
  {
    name: 'Funded by the European Union · Goethe-Institut',
    logo: '/logos/ue-goethe.webp',
    href: 'https://culture.ec.europa.eu/calls/culture-moves-europe',
    h: 48,
  },
  {
    name: 'Gobierno de España · Ministerio de Cultura',
    logo: '/logos/ministerio-cultura.svg',
    href: 'https://www.cultura.gob.es/',
    h: 66,
  },
  { name: 'Principado de Asturias', logo: '/logos/asturias.png', href: 'https://www.asturias.es/', h: 54 },
  { name: 'Caja Rural de Asturias', logo: '/logos/caja-rural.jpg', href: 'https://www.cajaruraldeasturias.com/', h: 52 },
];
---

<footer class="adar-footer">
  <div class="adar-footer-divider" aria-hidden="true">
    <svg class="adar-footer-mountains" viewBox="0 0 1200 140" preserveAspectRatio="none" role="presentation">
      <path d="M0,110 L60,108 L90,105 L130,109 L170,100 L210,108 L260,96 L310,106 L350,95 L390,102 L430,90 L480,100 L520,92 L560,104 L600,88 L650,98 L700,92 L750,104 L800,95 L850,108 L900,98 L950,110 L1000,103 L1050,110 L1100,106 L1150,112 L1200,110 L1200,140 L0,140 Z"></path>
      <path class="front" d="M0,120 L40,115 L80,118 L120,110 L160,120 L200,102 L240,115 L280,95 L320,108 L360,98 L400,112 L440,90 L480,105 L520,92 L560,108 L600,86 L640,100 L680,92 L720,108 L760,95 L800,110 L840,100 L880,118 L920,104 L960,120 L1000,108 L1040,118 L1080,110 L1120,120 L1160,112 L1200,120 L1200,140 L0,140 Z"></path>
    </svg>
  </div>

  <div class="adar-footer-logos">
    <div class="adar-footer-logos-row adar-footer-logos-funders">
      <p class="adar-funders-label">{copy.funded}</p>
      <ul>
        {FUNDERS.map((f) => (
          <li style={`--marca-h:${f.h}px`}>
            <a href={f.href} target="_blank" rel="noopener" aria-label={f.name}>
              <img src={f.logo} alt={f.name} loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
      <p class="adar-funders-note">
        {copy.funded_asturias}{' '}{copy.funded_note}{' '}
        <a href={copy.funded_href}>{copy.funded_link} →</a>
      </p>
    </div>
    <div class="adar-footer-logos-row adar-footer-logos-partners">
      <ul>
        {PARTNERS.map((p) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener" aria-label={p.name}>
              <img src={p.logo} alt={p.name} loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="adar-footer-inner">
    <div class="adar-footer-col">
      <h3>Festival ADAR</h3>
      <p class="adar-razon-social">{copy.desc}</p>
      <p class="adar-small">{copy.base}</p>

      <div class="adar-lang" aria-label="Language">
        <a class={`adar-lang-link ${lang === 'es' ? 'is-active' : ''}`} href={`/es/${HOME_SLUG.es}/`}>ES</a>
        <a class={`adar-lang-link ${lang === 'en' ? 'is-active' : ''}`} href={`/en/${HOME_SLUG.en}/`}>EN</a>
        <a class={`adar-lang-link ${lang === 'ast' ? 'is-active' : ''}`} href={`/ast/${HOME_SLUG.ast}/`}>AST</a>
      </div>
    </div>

    <div class="adar-footer-col">
      <h4>{copy.contact}</h4>
      <p>
        <a class="adar-footer-link" href="mailto:leiguardamusic@gmail.com">
          leiguardamusic@gmail.com
        </a>
      </p>
      <p>
        <a class="adar-footer-link" href="https://wa.me/34663604030" target="_blank" rel="noopener">
          WhatsApp · +34 663 60 40 30
        </a>
      </p>

      <p>
        <a class="adar-footer-link adar-footer-propose" href={copy.propose_href}>
          {copy.propose} <span aria-hidden="true">→</span>
        </a>
      </p>

      <div class="adar-social">
        <a href="https://www.instagram.com/festivaladar" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/festivaladar" target="_blank" rel="noopener">Facebook</a>
        <a href="https://www.youtube.com/@festivaladar" target="_blank" rel="noopener">YouTube</a>
      </div>
    </div>

    <div class="adar-footer-col">
      <img class="adar-footer-mark" src="/logos/adar.png" alt="Festival ADAR" />
    </div>
  </div>

  <div class="adar-footer-bottom">
    <span>© {new Date().getFullYear()} Festival ADAR</span>
    <button type="button" class="adar-bill-btn" data-bill={BILLING} data-done={copy.bill_done}>
      <span class="adar-bill-ico" aria-hidden="true">⧉</span> {copy.bill_copy}
    </button>
  </div>
</footer>

<script is:inline>
  (function () {
    var btn = document.querySelector('.adar-bill-btn');
    if (!btn) return;
    var label = btn.innerHTML;
    btn.addEventListener('click', function () {
      var text = (btn.getAttribute('data-bill') || '').split('|').join('\n');
      var done = btn.getAttribute('data-done') || '✓';
      function ok() {
        btn.textContent = done;
        btn.classList.add('is-done');
        setTimeout(function () { btn.innerHTML = label; btn.classList.remove('is-done'); }, 1900);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(ok, fallback);
      } else { fallback(); }
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.focus(); ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta); ok();
      }
    });
  })();
</script>
