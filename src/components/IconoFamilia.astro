---
// Un icono por familia de convocatoria. A línea, en currentColor, para que
// herede el color del sitio y no haya que mantener versiones claras y oscuras.
//
// El del territorio es un hórreo —tejado a cuatro aguas sobre pegollos—, que
// se distingue de la casa de residencias precisamente por las patas.
import type { Familia } from '../data/convocatorias.ts';

interface Props {
  familia: Familia;
  /** Lado del icono en píxeles. */
  size?: number;
}
const { familia, size = 26 } = Astro.props;
---

<svg
  class="ic-fam"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {familia === 'programacion' && (
    <>
      {/* Nota musical: proponer un programa. */}
      <path d="M9 17.5V5l10-2v12.5" />
      <circle cx="6.8" cy="17.5" r="2.3" />
      <circle cx="16.8" cy="15.5" r="2.3" />
    </>
  )}

  {familia === 'residencias' && (
    <>
      {/* Casa: la residencia es quedarse a vivir y trabajar. */}
      <path d="M3 11 12 4l9 7" />
      <path d="M5.5 9.6V20h13V9.6" />
      <path d="M10 20v-5.2h4V20" />
    </>
  )}

  {familia === 'territorio' && (
    <>
      {/* Hórreo: tejado, cuerpo y los cuatro pegollos. */}
      <path d="M2.5 9.2 12 3.5l9.5 5.7" />
      <path d="M5 9.4v6.4h14V9.4" />
      <path d="M7 15.8V20M10.4 15.8V20M13.6 15.8V20M17 15.8V20" />
    </>
  )}

  {familia === 'colaboracion' && (
    <>
      {/* Dos flechas en sentidos opuestos: el intercambio entre festivales. */}
      <path d="M3.5 9.5h16l-3.6-3.6" />
      <path d="M20.5 15h-16l3.6 3.6" />
    </>
  )}

  {familia === 'equipo' && (
    <>
      {/* Una persona: entrar a formar parte del equipo. */}
      <circle cx="12" cy="8" r="3.4" />
      <path d="M4.8 20c0-3.7 3.2-6.2 7.2-6.2s7.2 2.5 7.2 6.2" />
    </>
  )}
</svg>

<style is:global>
  body .entry-content .ic-fam {
    display: block;
    flex: 0 0 auto;
    color: inherit;
  }
</style>
